<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenWrtApStats</RootNamespace>
    <AssemblyName>OpenWrtApStats</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <DockerfileFile>..\Dockerfile</DockerfileFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow the test project to exercise internal types (e.g., SshAlgorithmFallbackPolicy)
         without forcing them public. Production callers within OpenWrtApStats remain unaffected. -->
    <InternalsVisibleTo Include="OpenWrtApStats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DASH-13 / D-21: IEEE OUI registry snapshot loaded by OuiLookup at startup. -->
    <EmbeddedResource Include="Data/Resources/oui.csv" />
  </ItemGroup>
</Project>
