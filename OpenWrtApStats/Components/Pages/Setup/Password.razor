@page "/setup/password"
@layout SetupLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@* Pitfall 2: opt out of D-06 global InteractiveServer — sign-in needs static SSR roundtrip.
   No [EnableRateLimiting] — wizard is one-shot per install, not the primary auth entry point. *@
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using OpenWrtApStats.Services.Auth
@using OpenWrtApStats.Services.Settings

@inject IAppSettingsService Settings
@inject IUIPasswordHasher Hasher
@inject NavigationManager Nav

<h3 class="card-title mb-1">Set a UI password</h3>
<small class="text-body-secondary">Setting a password requires sign-in for all dashboard pages. You can skip this and set a password later in Settings.</small>

<EditForm Model="form" method="post" OnValidSubmit="HandleSubmitAsync" FormName="setup-password" class="mt-3">
    <DataAnnotationsValidator />
    <AntiforgeryToken />

    <div class="input-group mb-1">
        <InputText type="password" class="form-control" placeholder="Password" autocomplete="new-password"
                   @bind-Value="form.Password" />
        <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
    </div>
    <ValidationMessage For="@(() => form.Password)" class="invalid-feedback d-block" />
    <small class="form-text text-body-secondary mb-3 d-block">Stored as a one-way hash — not recoverable if lost.</small>

    <div class="input-group mb-1">
        <InputText type="password" class="form-control" placeholder="Confirm password" autocomplete="new-password"
                   @bind-Value="form.ConfirmPassword" />
        <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
    </div>
    <ValidationMessage For="@(() => form.ConfirmPassword)" class="invalid-feedback d-block" />

    <div class="d-flex justify-content-between mt-3">
        <button type="submit" name="action" value="skip" class="btn btn-outline-secondary">Skip password</button>
        <button type="submit" name="action" value="set" class="btn btn-primary">Set password and continue</button>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm] private SetupPasswordForm form { get; set; } = default!;
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    public sealed class SetupPasswordForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string? Password { get; set; }

        [System.ComponentModel.DataAnnotations.Compare("Password", ErrorMessage = "Passwords do not match.")]
        public string? ConfirmPassword { get; set; }
    }

    protected override void OnInitialized()
    {
        // Initialize the form model lazily (BL0008 prohibits initializer on [SupplyParameterFromForm]).
        form ??= new SetupPasswordForm();
    }

    private async Task HandleSubmitAsync()
    {
        var action = HttpContext.Request.Form["action"].ToString();
        if (action == "set")
        {
            // Validate fields match
            if (string.IsNullOrEmpty(form.Password) || form.Password != form.ConfirmPassword)
                return;  // DataAnnotationsValidator shows errors

            var hash = Hasher.Hash(form.Password);
            await Settings.SetUIPasswordHashAsync(hash, HttpContext.RequestAborted);

            // Sign in — copy VERBATIM from Login.razor:121-129
            var claims = new[] { new Claim(ClaimTypes.Name, "operator") };
            var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                new ClaimsPrincipal(identity));
        }

        // Both "set" and "skip" navigate to Step 2.
        // forceLoad: true MANDATORY — Pitfall 2 antiforgery rebind after sign-in.
        Nav.NavigateTo("/setup/nodes", forceLoad: true);
    }
}
