@page "/setup/password"
@layout SetupLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@* Pitfall 2: static SSR required — form POSTs to a minimal API endpoint (/setup/submit-password),
   which needs the real HTTP response pipeline. InteractiveServer breaks plain form → redirect flow. *@

<h3 class="card-title mb-1">Set a UI password</h3>
<small class="text-body-secondary">Setting a password requires sign-in for all dashboard pages. You can skip this and set a password later in Settings.</small>

@if (Error is not null)
{
    <div class="alert alert-danger mt-3">@Error</div>
}

<form method="post" action="/setup/submit-password" class="mt-3">
    <AntiforgeryToken />

    <div class="input-group mb-1">
        <input type="password" class="form-control" name="Password" placeholder="Password" autocomplete="new-password" required />
        <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
    </div>
    <small class="form-text text-body-secondary mb-3 d-block">Stored as a one-way hash — not recoverable if lost.</small>

    <div class="input-group mb-1">
        <input type="password" class="form-control" name="ConfirmPassword" placeholder="Confirm password" autocomplete="new-password" />
        <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <button type="submit" name="action" value="skip" class="btn btn-outline-secondary" formnovalidate>Skip password</button>
        <button type="submit" name="action" value="set" class="btn btn-primary">Set password and continue</button>
    </div>
</form>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
}
