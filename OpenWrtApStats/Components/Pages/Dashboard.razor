@page "/"
@using OpenWrtApStats.Components.Shared
@using OpenWrtApStats.Services
@using OpenWrtApStats.Services.Polling
@using OpenWrtApStats.Services.Settings
@using OpenWrtApStats.Services.Vendor
@using OpenWrtApStats.Web.Helpers
@implements IDisposable

@inject INodeRepo Nodes
@inject INetworkRepo Networks
@inject IStationRepo Stations
@inject IOuiLookup Oui
@inject IAppSettingsService Settings
@inject PollNotifier Notifier
@inject PreferencesService Prefs

@* Dashboard.razor — Phase 5 live-push view (REORGANIZED Phase 8 — REQ-UI-10..13, REQ-UI-22, REQ-UI-23, REQ-UI-53).
   Phase 5 mechanics (Virtualize table, sort, search predicate, ComputeFilteredRows, IsStale, OnCycledAsync) preserved verbatim.
   Phase 8 reorg: per-AP strip removed, KpiTileBar mounted above filters, search + 3 chips wrapped in AdminLTE filter card with
   Reset filters button, view-state restored from PreferencesService at first render, AP chip status badges via
   FilterChipGroup.StatusBadgeFor (Plan 03 extension), per-row Status-change CSS hook for the Plan 10 fade animation. *@

<PageHeader Title="Dashboard">
    <HeaderActions>
        @* Reset filters lives next to the page title (operator-driven move from the filter
           card header). Rendered only on the populated branch — when EmptyState is showing
           there are no filters to reset. Same visual aspect as before: btn-link + icon. *@
        @if (!_loading && _nodeCount > 0 && _anyEnabledWlan)
        {
            <button type="button" class="btn btn-link btn-sm"
                    aria-label="Reset filters" @onclick="ResetFiltersAsync">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>Reset filters
            </button>
        }
    </HeaderActions>
</PageHeader>

@if (_loading)
{
    <p class="text-body-secondary">Loading…</p>
}
else if (_nodeCount == 0)
{
    @* DASH-09 zero-nodes empty state. D-09 (Phase 4): primary CTA conditional on WizardDismissed.
       Phase 7 row 4.1 follow-up: when WizardDismissed=true the primary stays "Add your first
       OpenWRT node" but a secondary "Continue setup" link is rendered below — honors the
       SetupLayout "you can always finish setup later from the dashboard" promise. *@
    <EmptyState IconClass="bi-router-fill"
                Heading="No access points yet"
                Body="@(_wizardDismissed
                    ? "Add your first OpenWRT access point to start monitoring connected stations."
                    : "Your access points are not configured yet. Continue the setup wizard to get started.")"
                CtaLabel="@(_wizardDismissed ? "Add your first OpenWRT node" : "Continue setup")"
                CtaHref="@(_wizardDismissed ? "/Nodes/Add" : "/setup/password")"
                CtaIconClass="@(_wizardDismissed ? "bi-plus-lg" : "bi-arrow-right-circle")"
                SecondaryLabel="@(_wizardDismissed ? "Continue setup" : "")"
                SecondaryHref="@(_wizardDismissed ? "/setup/password" : "")"
                SecondaryIconClass="@(_wizardDismissed ? "bi-arrow-right-circle" : "")" />
}
else if (!_anyEnabledWlan)
{
    @* DASH-10 nodes-but-all-WLANs-disabled empty state. UI-SPEC §Dashboard DASH-10. *@
    <EmptyState IconClass="bi-wifi-off"
                Heading="No WLANs are being monitored"
                Body="@DashTenBody"
                CtaLabel="Enable a WLAN"
                CtaHref="@($"/Nodes/{_firstNodeId}")"
                CtaIconClass="bi-wifi" />
}
else
{
    @* 2. KPI tile bar — Phase 8 (REQ-UI-01..04, REQ-UI-13). Bidirectionally
       synced with the Status FilterChipGroup via _statusFilter. *@
    <KpiTileBar Rows="_lastFilteredKpiRows" Active="_statusFilter" OnActiveChanged="OnKpiSelectedAsync" />

    @* 3. Filter card — Phase 8 (REQ-UI-12). AdminLTE card with header "Filters",
       search + 3 chip groups in a 5/7 grid. Reset filters lives in PageHeader actions. *@
    <div class="card mb-3">
        <div class="card-header py-2 px-3">
            <h6 class="card-sub-title mb-0">Filters</h6>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="visually-hidden" for="dashboard-search">Search stations</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                        <input id="dashboard-search" class="form-control" type="search"
                               placeholder="Search MAC, hostname, name, IP, or vendor"
                               @bind="_searchText" @bind:event="oninput"
                               @bind:after="OnSearchChangedAsync" />
                    </div>
                </div>
                <div class="col-md-7">
                    <FilterChipGroup Title="SSID" Options="_allSsids"
                                     Selected="_selectedSsids" OnToggled="OnToggleSsidAsync" />
                    <FilterChipGroup Title="AP" Options="_allApLabels"
                                     Selected="_selectedApLabels" OnToggled="OnToggleApAsync"
                                     StatusBadgeFor="@(ap => MapNodeStatus(ap))" />
                    <FilterChipGroup Title="Status" Options="StatusFilterOptions"
                                     Selected="_selectedStatuses" OnToggled="OnToggleStatusAsync" />
                </div>
            </div>
        </div>
    </div>

    if (_rows.Count == 0)
    {
        @* DASH-11 NEW Phase 5: WLANs healthy, zero stations.
           Plan 02 made EmptyState CTA params optional; we omit them here entirely. *@
        <EmptyState IconClass="bi-wifi"
                    Heading="WLANs are healthy, no clients right now"
                    Body="@($"Last poll: {RelativeTime(_lastPollUtc)}.")" />
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0 table-sm">
                        <thead class="sticky-top bg-body">
                            <tr>
                                <SortHeaderCell Column="name"     CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">Name</SortHeaderCell>
                                <SortHeaderCell Column="mac"      CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">MAC</SortHeaderCell>
                                <SortHeaderCell Column="vendor"   CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">Vendor</SortHeaderCell>
                                <SortHeaderCell Column="ip"       CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">IP</SortHeaderCell>
                                <SortHeaderCell Column="ssid"     CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">SSID</SortHeaderCell>
                                <SortHeaderCell Column="ap"       CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">AP</SortHeaderCell>
                                <SortHeaderCell Column="rssi"     CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">RSSI</SortHeaderCell>
                                <SortHeaderCell Column="lastSeen" CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">Last seen</SortHeaderCell>
                                <SortHeaderCell Column="status"   CurrentSort="@_sortColumn" Descending="_sortDescending" OnSort="ApplySort">Status</SortHeaderCell>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="ComputeFilteredRows()" ItemSize="40" Context="row">
                                <ItemContent>
                                    <tr class="@(_changedRowMacs.Contains(row.Mac) ? "row-status-changed" : null)"
                                        title="@BuildRowTooltip(row)">
                                        <td><a href="@($"/Stations/{Uri.EscapeDataString(row.Mac)}")">@(string.IsNullOrEmpty(row.Name) ? (string.IsNullOrEmpty(row.Hostname) ? row.Mac : HostnameDisplay.StripLocalSuffix(row.Hostname, Settings.LocalDomainSuffixes)) : row.Name)</a></td>
                                        <td>
                                            <code class="font-monospace">@row.Mac</code>
                                            @if (row.IsRandomMac)
                                            {
                                                <span class="badge text-bg-warning ms-2"
                                                      title="Locally administered MAC — likely a privacy-randomized address. Toggle on the station detail page if this is a stable virtualized MAC.">
                                                    <i class="bi bi-shuffle" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Random MAC</span>
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(row.Vendor))
                                            {
                                                @row.Vendor
                                            }
                                            else
                                            {
                                                <span class="text-body-secondary">Unknown vendor</span>
                                            }
                                        </td>
                                        <td><code class="font-monospace">@(string.IsNullOrEmpty(row.Ip) ? "—" : row.Ip)</code></td>
                                        <td>@row.Ssid</td>
                                        <td class="text-nowrap">@row.ApHostname</td>
                                        <td><RssiCell Rss="row.Rss" /></td>
                                        <td>@RelativeTime(row.LastSeen)</td>
                                        <td><StatusBadge Status="row.StationStatus" IsStale="@IsStale(row)" /></td>
                                    </tr>
                                </ItemContent>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-body-secondary small d-flex justify-content-between py-2 px-3" data-testid="dashboard-row-counter">
                    <span>
                        @if (_lastFilteredCount == _rows.Count)
                        {
                            <text>Showing @_rows.Count of @_rows.Count entries</text>
                        }
                        else
                        {
                            <text>Showing @_lastFilteredCount of @_rows.Count entries (filtered)</text>
                        }
                    </span>
                    <span class="ms-auto text-end">Last poll: @RelativeTime(_lastPollUtc)</span>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    private int _nodeCount;
    private bool _anyEnabledWlan;
    private int _firstNodeId;
    private bool _wizardDismissed;

    private IReadOnlyList<WiFiNode> _nodes = Array.Empty<WiFiNode>();
    private List<DashboardRow> _rows = new();

    // Filter / sort / search state — survives Cycled re-queries naturally (only _rows + _nodes + _cycleEndUtc replaced).
    private string _searchText = "";
    private string _sortColumn = "name";
    private bool   _sortDescending = false;
    private HashSet<string> _selectedSsids = new();
    private HashSet<int>    _selectedAps = new();           // node Ids — kept for Phase 5 ComputeFilteredRows compatibility (legacy strip removed in Phase 8)
    private HashSet<string> _selectedApLabels = new();      // hostname strings — written by AP FilterChipGroup
    private HashSet<string> _selectedStatuses = new();      // "Online" / "Offline" / "Stale"
    private List<string>    _allSsids = new();
    private List<string>    _allApLabels = new();

    // Status filter options are fixed (3 derived UI categories) — not derived from data.
    // "Stale" is a UI-only sub-state of Offline (Status.Offline + IsStale predicate).
    private static readonly IReadOnlyList<string> StatusFilterOptions =
        new[] { "Online", "Offline", "Stale" };

    private DateTime _cycleEndUtc = DateTime.UtcNow;
    private DateTime _lastPollUtc = DateTime.UtcNow;

    // Updated as a side effect of ComputeFilteredRows() so the card-footer can render
    // "Showing X of Y" without re-running the LINQ pipeline a second time per render.
    private int _lastFilteredCount;

    // --- Phase 8 NEW state (REQ-UI-22, REQ-UI-53, KpiTileBar wiring) ---
    private bool _restored;                                                                  // PITFALLS.md Pitfall 7 prerender guard
    private StatusFilter? _statusFilter;                                                     // KPI tile selection (bidirectionally synced with _selectedStatuses)
    private List<DashboardKpiRow> _lastFilteredKpiRows = new();                              // projection passed to <KpiTileBar Rows="..."/>
    private readonly HashSet<string> _changedRowMacs = new();                                // REQ-UI-53 row-status-changed hook (one render frame)
    private Dictionary<string, OpenWrtApStats.Data.Models.Status> _prevRowStatus = new();    // diff source for DetectRowStatusChanges

    private string DashTenBody =>
        $"You have {_nodeCount} access point{(_nodeCount == 1 ? "" : "s")} configured, but every WLAN is disabled. Enable at least one WLAN to start seeing connected stations.";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        // Build the initial KPI projection so the first <KpiTileBar Rows=...> render is non-empty.
        RefreshFilteredKpiRows();
        // Subscribe AFTER initial load so the first Cycled event isn't lost between OnInit and Dispose.
        Notifier.Cycled += OnCycledAsync;
        _loading = false;
    }

    /// <summary>
    /// REQ-UI-22 / CLAUDE.md prerender rule: localStorage / JS interop is FORBIDDEN during prerender.
    /// Restore search / active-filters / sort-state / KPI selection from PreferencesService here, on the
    /// first render only, guarded by `_restored` and explicit StateHasChanged() per PITFALLS.md Pitfall 7.
    /// Any failure (interop unavailable, JSON malformed, etc.) is swallowed — the page stays functional
    /// with default state.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _restored) return;

        try
        {
            var search = await Prefs.GetSearchTextAsync();
            if (!string.IsNullOrEmpty(search)) _searchText = search;

            var filters = await Prefs.GetActiveFiltersAsync();
            if (filters.Ssids.Count > 0)     _selectedSsids = new HashSet<string>(filters.Ssids);
            // Persisted DashboardFilters.Aps holds hostname strings (the AP FilterChipGroup option set);
            // restore them into _selectedApLabels. _selectedAps (node-Id set) stays empty — the
            // legacy per-AP strip is gone in Phase 8.
            if (filters.Aps.Count > 0)       _selectedApLabels = new HashSet<string>(filters.Aps);
            if (filters.Statuses.Count > 0)  _selectedStatuses = new HashSet<string>(filters.Statuses);

            var sort = await Prefs.GetSortStateAsync();
            if (sort is not null)
            {
                _sortColumn = sort.Column;
                _sortDescending = sort.Descending;
            }

            _statusFilter = await Prefs.GetKpiSelectionAsync();
            ApplyKpiToStatusFilter();   // mirror KPI selection -> _selectedStatuses (ComputeFilteredRows reads _selectedStatuses)
            RefreshFilteredKpiRows();
        }
        catch (Exception)
        {
            // Prerender or interop unavailable; the page remains functional with default state.
        }
        finally
        {
            _restored = true;
            StateHasChanged();
        }
    }

    private async Task ReloadAsync()
    {
        var allNodes = await Nodes.GetAllAsync();
        _nodes = allNodes;
        _nodeCount = allNodes.Count;
        _wizardDismissed = Settings.WizardDismissed;

        if (_nodeCount > 0)
        {
            _firstNodeId = allNodes.OrderBy(n => n.Id).First().Id;
            _anyEnabledWlan = await Networks.AnyEnabledAsync();
        }

        if (_anyEnabledWlan)
        {
            _rows = await BuildRowsAsync(allNodes);
            _allSsids    = _rows.Select(r => r.Ssid).Distinct().OrderBy(s => s).ToList();
            _allApLabels = _rows.Select(r => r.ApHostname).Distinct().OrderBy(a => a).ToList();
        }
    }

    private async Task OnCycledAsync(PollSnapshot snapshot)
    {
        // Pitfall 7: Cycled handler arrives off the orchestrator's stack frame, OUTSIDE
        // the Blazor circuit's sync context. Wrap state mutation + StateHasChanged.
        await InvokeAsync(async () =>
        {
            _cycleEndUtc = snapshot.CycleEndUtc;
            _lastPollUtc = snapshot.CycleEndUtc;
            await ReloadAsync();
            DetectRowStatusChanges();      // REQ-UI-53 — must run AFTER ReloadAsync rebuilds _rows
            RefreshFilteredKpiRows();      // KpiTileBar.Rows projection
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        // Pattern 2: unsubscribe to release captured `this`. Singleton Notifier outlives circuit.
        Notifier.Cycled -= OnCycledAsync;
    }

    private async Task<List<DashboardRow>> BuildRowsAsync(IReadOnlyList<WiFiNode> allNodes)
    {
        // Build a (WiFiNetworkId → (SSID, NodeHostname, NodeId, Enabled)) lookup.
        var networkLookup = new Dictionary<int, (string Ssid, string ApHostname, int ApNodeId, bool Enabled)>();
        foreach (var n in allNodes)
        {
            var networks = await Networks.GetByNodeAsync(n.Id);
            foreach (var w in networks)
            {
                networkLookup[w.Id] = (w.SSID, n.Hostname, n.Id, w.Enabled);
            }
        }

        var stations = await Stations.GetAllAsync();
        var rows = new List<DashboardRow>(stations.Count);
        foreach (var s in stations)
        {
            if (s.WiFiNetworkId is not int netId) continue;
            if (!networkLookup.TryGetValue(netId, out var net)) continue;
            if (!net.Enabled) continue;

            rows.Add(new DashboardRow(
                Name: s.Name,
                Hostname: s.Hostname,
                Mac: s.MacAddress,
                Vendor: Oui.GetVendor(s.MacAddress),
                Ip: s.IPAddress,
                Ssid: net.Ssid,
                ApHostname: net.ApHostname,
                ApNodeId: net.ApNodeId,
                Rss: s.RSS,
                LastSeen: s.LastPollDate,
                StationStatus: s.Status,
                IsRandomMac: s.IsRandomMac));
        }
        return rows;
    }

    private List<DashboardRow> ComputeFilteredRows()
    {
        IEnumerable<DashboardRow> q = _rows;

        // Search predicate (UI-SPEC lines 870-879)
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var needle = _searchText.Trim();
            q = q.Where(r =>
                (r.Name?.Contains(needle, StringComparison.OrdinalIgnoreCase)     ?? false)
             || (r.Hostname?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false)
             ||  r.Mac.Contains(needle, StringComparison.OrdinalIgnoreCase)
             || (r.Ip?.Contains(needle, StringComparison.OrdinalIgnoreCase)       ?? false)
             || (r.Vendor?.Contains(needle, StringComparison.OrdinalIgnoreCase)   ?? false));
        }

        // SSID filter — OR within (CONTEXT D-06)
        if (_selectedSsids.Count > 0)
        {
            q = q.Where(r => _selectedSsids.Contains(r.Ssid));
        }

        // AP filter — composes from BOTH the legacy node-Id set (_selectedAps, always empty in Phase 8
        // post-strip-delete) AND the chip group hostname set (_selectedApLabels). Single source
        // of truth retained for backward compatibility.
        if (_selectedAps.Count > 0 || _selectedApLabels.Count > 0)
        {
            q = q.Where(r => _selectedAps.Contains(r.ApNodeId) || _selectedApLabels.Contains(r.ApHostname));
        }

        // Status filter — OR within (consistent with SSID/AP). "Stale" is a UI-only sub-state
        // of Offline computed via IsStale(row); selecting "Offline" excludes Stale rows so the
        // three categories partition the result cleanly.
        if (_selectedStatuses.Count > 0)
        {
            q = q.Where(r =>
            {
                if (r.StationStatus == Status.Online) return _selectedStatuses.Contains("Online");
                var stale = IsStale(r);
                return stale
                    ? _selectedStatuses.Contains("Stale")
                    : _selectedStatuses.Contains("Offline");
            });
        }

        // Sort (UI-SPEC §Sort behavior — secondary stable sort by MAC asc)
        Func<DashboardRow, IComparable?> key = _sortColumn switch
        {
            "name"     => r => r.Name ?? r.Hostname ?? r.Mac,
            "mac"      => r => r.Mac,
            "vendor"   => r => r.Vendor ?? "",
            "ip"       => r => r.Ip ?? "",
            "ssid"     => r => r.Ssid,
            "ap"       => r => r.ApHostname,
            "rssi"     => r => r.Rss,
            "lastSeen" => r => r.LastSeen,
            "status"   => r => (int)r.StationStatus,
            _          => r => r.LastSeen,
        };

        // RSSI null sorts LAST in BOTH directions (UI-SPEC line 889).
        IOrderedEnumerable<DashboardRow> ordered;
        if (_sortColumn == "rssi")
        {
            ordered = _sortDescending
                ? q.OrderBy(r => r.Rss is null).ThenByDescending(r => r.Rss)
                : q.OrderBy(r => r.Rss is null).ThenBy(r => r.Rss);
        }
        else
        {
            ordered = _sortDescending
                ? q.OrderByDescending(key)
                : q.OrderBy(key);
        }
        // Stable secondary sort by MAC asc (UI-SPEC line 885)
        var result = ordered.ThenBy(r => r.Mac, StringComparer.OrdinalIgnoreCase).ToList();
        // Cache for the card-footer "Showing X of Y" counter; Razor evaluates the Virtualize
        // Items= parameter before rendering tfoot/footer, so the field is current at read time.
        _lastFilteredCount = result.Count;
        return result;
    }

    private bool IsStale(DashboardRow row)
    {
        // D-08 multiplier 2 -- UI-SPEC line 700 (05-UI-SPEC.md). Sense is `<`: Stale
        // is the transient window WITHIN 2 cycles of LastSeen; beyond 2 cycles -> Offline.
        // SpecifyKind(Utc): SQLite round-trips DateTimes with Kind=Unspecified; the
        // orchestrator only ever writes UTC, so reattach the kind before the subtraction.
        // ToUniversalTime() on Unspecified treats it as local and overshoots by N hours.
        if (row.StationStatus != Status.Offline) return false;
        var threshold = TimeSpan.FromSeconds(2 * Settings.PollingIntervalSeconds);
        var elapsed = _cycleEndUtc - DateTime.SpecifyKind(row.LastSeen, DateTimeKind.Utc);
        return elapsed < threshold;
    }

    private void ApplySort(string column)
    {
        if (string.Equals(_sortColumn, column, StringComparison.OrdinalIgnoreCase))
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        // Phase 8: persist sort state to localStorage. Fire-and-forget — failures are swallowed
        // upstream by SetJsonAsync.
        _ = Prefs.SetSortStateAsync(new SortState(_sortColumn, _sortDescending));
    }

    // --- Phase 8 NEW handlers (REQ-UI-02 bidirectional sync, REQ-UI-22 persistence, REQ-UI-23 reset) ---

    private async Task OnKpiSelectedAsync(StatusFilter? value)
    {
        _statusFilter = value;
        ApplyKpiToStatusFilter();
        await Prefs.SetKpiSelectionAsync(value);
        await PersistFiltersAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Mirror _statusFilter into _selectedStatuses so the existing Phase 5 filter pipeline
    /// (which reads _selectedStatuses) honors the KPI tile selection. Single direction
    /// (KPI → status set); the reverse direction is handled by OnToggleStatusAsync.
    /// </summary>
    private void ApplyKpiToStatusFilter()
    {
        _selectedStatuses.Clear();
        if (_statusFilter is StatusFilter.Online)  _selectedStatuses.Add("Online");
        if (_statusFilter is StatusFilter.Stale)   _selectedStatuses.Add("Stale");
        if (_statusFilter is StatusFilter.Offline) _selectedStatuses.Add("Offline");
        // null -> no Status filter (All tile active).
    }

    private async Task OnSearchChangedAsync()
    {
        await Prefs.SetSearchTextAsync(_searchText);
        StateHasChanged();
    }

    private async Task OnToggleSsidAsync(string ssid)
    {
        if (!_selectedSsids.Add(ssid)) _selectedSsids.Remove(ssid);
        await PersistFiltersAsync();
    }

    private async Task OnToggleApAsync(string apHostname)
    {
        if (!_selectedApLabels.Add(apHostname)) _selectedApLabels.Remove(apHostname);
        await PersistFiltersAsync();
    }

    private async Task OnToggleStatusAsync(string status)
    {
        if (!_selectedStatuses.Add(status)) _selectedStatuses.Remove(status);
        // Mirror Status chip → KPI tile (REQ-UI-02 reverse direction).
        // INFO #7 asymmetry: when the user has multiple statuses selected (e.g. Online+Stale),
        // there is no single KPI tile that represents that compound filter, so we set
        // _statusFilter = null (the "All" tile shows active in the bar even though the chip
        // group filters to two values). Documented + accepted (plan-checker INFO 7).
        _statusFilter = _selectedStatuses.Count == 1
            ? (Enum.TryParse<StatusFilter>(_selectedStatuses.First(), out var sf) ? sf : (StatusFilter?)null)
            : null;
        await Prefs.SetKpiSelectionAsync(_statusFilter);
        await PersistFiltersAsync();
    }

    private Task PersistFiltersAsync() => Prefs.SetActiveFiltersAsync(
        new DashboardFilters(
            _selectedSsids.ToList(),
            _selectedApLabels.ToList(),                  // hostname strings (Phase 5 AP chip group)
            _selectedStatuses.ToList()));

    private async Task ResetFiltersAsync()
    {
        // REQ-UI-23: clear search/filters/sort/KPI; LEAVE theme/sidebar/notifications untouched.
        _searchText = string.Empty;
        _selectedSsids.Clear();
        _selectedAps.Clear();              // node-Id set (post-strip-delete this is always empty, but reset for safety)
        _selectedApLabels.Clear();         // hostname set written by AP FilterChipGroup
        _selectedStatuses.Clear();
        _statusFilter = null;
        // Default sort: column "name", ascending (operator-driven, 260508-dns).
        _sortColumn = "name";
        _sortDescending = false;
        await Prefs.ClearViewStateAsync();
        StateHasChanged();
    }

    /// <summary>
    /// REQ-UI-11 — AP chip status badge mapping. Looks up the AP's current status from `_nodes`
    /// (Phase 5 IReadOnlyList&lt;WiFiNode&gt;) and translates to the Plan 03 BadgeState enum.
    /// Phase 5 has no `_nodeIndex` — linear-scan `_nodes` by hostname (cheap; typical deployment &lt; 20 APs).
    /// "Stale" for nodes is a UI-only sub-state computed via the same threshold formula Phase 5's
    /// IsStale uses for stations: status == Offline AND elapsed &lt; 2 * pollingInterval.
    /// </summary>
    private FilterChipGroup.BadgeState MapNodeStatus(string apHostname)
    {
        OpenWrtApStats.Data.Models.WiFiNode? node = null;
        foreach (var n in _nodes) { if (n.Hostname == apHostname) { node = n; break; } }
        if (node is null) return FilterChipGroup.BadgeState.Hidden;
        if (node.Status == OpenWrtApStats.Data.Models.Status.Online) return FilterChipGroup.BadgeState.Online;
        var threshold = TimeSpan.FromSeconds(2 * Settings.PollingIntervalSeconds);
        var elapsed = _cycleEndUtc - DateTime.SpecifyKind(node.LastPollDate, DateTimeKind.Utc);
        return elapsed < threshold ? FilterChipGroup.BadgeState.Stale : FilterChipGroup.BadgeState.Offline;
    }

    /// <summary>
    /// REQ-UI-53 — recompute the per-MAC Status diff cycle-over-cycle. Adds MACs whose status
    /// changed to `_changedRowMacs`; the &lt;tr&gt; renders `class="row-status-changed"` for ONE
    /// frame, then `ClearChangedAfterFrameAsync` schedules a microtask to clear the set so the
    /// CSS animation (Plan 10) completes its 600ms cycle without re-triggering.
    /// </summary>
    private void DetectRowStatusChanges()
    {
        _changedRowMacs.Clear();
        foreach (var row in _rows)
        {
            if (_prevRowStatus.TryGetValue(row.Mac, out var prev) && prev != row.StationStatus)
            {
                _changedRowMacs.Add(row.Mac);
            }
            _prevRowStatus[row.Mac] = row.StationStatus;
        }
        // Schedule a microtask to clear the set after this render frame.
        _ = ClearChangedAfterFrameAsync();
    }

    private async Task ClearChangedAfterFrameAsync()
    {
        await Task.Yield();   // let the current render commit
        await InvokeAsync(() =>
        {
            _changedRowMacs.Clear();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Project the unfiltered Phase 5 _rows into the public DashboardKpiRow shape consumed
    /// by &lt;KpiTileBar Rows="..."/&gt;. Called once per Cycled (after ReloadAsync) and once
    /// in OnInitializedAsync so the first <KpiTileBar> render is non-empty.
    /// Note: KpiTileBar derives counts over the FULL row set (not the user's filter
    /// selection) — clicking a tile filters DOWN; the totals stay consistent.
    /// </summary>
    private void RefreshFilteredKpiRows()
    {
        _lastFilteredKpiRows = _rows
            .Select(r => new DashboardKpiRow(r.StationStatus, IsStale(r)))
            .ToList();
    }

    /// <summary>
    /// Phase 10 DASH-20 — row hover tooltip exposing the full identifier set per
    /// CONTEXT D-07. Bar-separated single-line format (newline behavior in HTML title
    /// attributes is browser-inconsistent; the bar is the safest cross-browser shape).
    /// HostnameDisplay.StripLocalSuffix produces the short form; the persisted FQDN is
    /// also surfaced verbatim. Random-MAC indicator mirrors DASH-21.
    /// </summary>
    private string BuildRowTooltip(DashboardRow row)
    {
        var shortHostname = HostnameDisplay.StripLocalSuffix(row.Hostname, Settings.LocalDomainSuffixes) ?? string.Empty;
        var name = string.IsNullOrEmpty(row.Name) ? string.Empty : row.Name;
        var fqdn = row.Hostname ?? string.Empty;
        var random = row.IsRandomMac ? "Yes" : "No";
        return $"Name: {name} | Hostname: {shortHostname} | FQDN: {fqdn} | MAC: {row.Mac} | Random MAC: {random}";
    }

    private static string RelativeTime(DateTime t)
    {
        if (t == default) return "Never";
        // SQLite has no native DateTime type — EF Core round-trips DateTimes back with
        // Kind=Unspecified. The orchestrator only ever writes DateTime.UtcNow, so treat
        // an Unspecified value as UTC; ToUniversalTime() would otherwise interpret it
        // as local and subtract the local offset (off-by-N hours bug).
        var d = DateTime.UtcNow - DateTime.SpecifyKind(t, DateTimeKind.Utc);
        if (d.TotalSeconds < 60) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    private sealed record DashboardRow(
        string? Name,
        string? Hostname,        // Phase 5 — search predicate matches hostname per DASH-04
        string Mac,
        string? Vendor,
        string? Ip,
        string Ssid,
        string ApHostname,
        int ApNodeId,            // Phase 5 — kept for backward compat (legacy AP filter-by-Id semantics)
        int? Rss,
        DateTime LastSeen,
        Status StationStatus,
        bool IsRandomMac);       // Phase 10 DASH-21 / DASH-23 — sourced from persisted WLANStation.IsRandomMac
}
