@page "/Nodes/Add"
@using Microsoft.AspNetCore.DataProtection

@inject INodeRepo Nodes
@inject IDataProtectionProvider Dpp
@inject NavigationManager Nav

@* /Nodes/Add — NODE-01 + NODE-02 (Test Connection). UI-SPEC §Node Add lines 332-358.
   Save encrypts the password through the same "node-creds" Data Protection purpose chain
   that Phase 2 production uses, then persists via INodeRepo.AddAsync.

   Debug add-form-noninteractive (2026-05-09): page is InteractiveServer, but if the
   Blazor SignalR circuit cannot establish in the deployed environment (reverse-proxy
   WS upgrade, sub-path base href, CSP, etc.), <EditForm FormName="node-form"> falls back
   to a static-SSR HTTP POST. Without [SupplyParameterFromForm], the SSR-bound model is a
   fresh empty NodeFormModel — DataAnnotations then re-renders "Hostname is required" /
   "Username is required" with the user's input wiped. Annotating the page-side model with
   [SupplyParameterFromForm(FormName = "node-form")] lets the form post bind back into the
   same instance, so Save works correctly even when the circuit is down. The InteractiveServer
   path still uses the same field — the attribute is a no-op when the circuit handles the
   submit. (Test Connection still requires interactivity; that is documented in the resolution.)

   BL0008 ("[SupplyParameterFromForm] property cannot have an initializer; the form post may
   overwrite with null") forbids `= new()` on the property — match the canonical Login.razor
   pattern: `= default!;` + lazy `??=` in OnInitialized. *@

<PageHeader Title="Add node" />

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">New access point</h5></div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_pageError))
        {
            <div class="alert alert-danger" role="alert">@_pageError</div>
        }
        <_NodeForm Model="_model" IsEdit="false" OnSave="HandleSaveAsync" />
    </div>
</div>

@code {
    // [SupplyParameterFromForm] binds the SSR-fallback POST body back into _model so the
    // page-level handler sees the operator's input even when no circuit is connected.
    // Property cannot have an initializer (BL0008) — initialized lazily in OnInitialized.
    [SupplyParameterFromForm(FormName = "node-form")]
    private NodeFormModel _model { get; set; } = default!;

    private string? _pageError;

    protected override void OnInitialized()
    {
        _model ??= new NodeFormModel();
    }

    private async Task HandleSaveAsync(NodeFormModel form)
    {
        // Add-path: Password is REQUIRED (UI-SPEC §Node Add Validation: "Password is required.").
        if (string.IsNullOrEmpty(form.Password))
        {
            _pageError = "Password is required.";
            return;
        }
        _pageError = null;

        // Encrypt through the same "node-creds" purpose chain Phase 2 production uses.
        var protector = Dpp.CreateProtector("node-creds");
        var encrypted = protector.Protect(form.Password);

        var node = new WiFiNode
        {
            Hostname = form.Hostname!.Trim(),
            Username = form.Username!.Trim(),
            Password = encrypted,
            Status = OpenWrtApStats.Data.Models.Status.Offline,
            HostKeyFingerprint = null   // first poll captures the TOFU fingerprint (Phase 2 D-02)
        };
        await Nodes.AddAsync(node);
        Nav.NavigateTo("/Nodes?saved=1", forceLoad: false);
    }
}
