@using Microsoft.AspNetCore.DataProtection
@using OpenWrtApStats.Services.Nodes

@inject ITestConnectionService TestConnection

@* Shared form for /Nodes/Add and /Nodes/{id}/Edit. UI-SPEC §Node Add lines 332-358 +
   §Node Edit lines 360-376. Edit pre-fills hostname + username; password ALWAYS empty
   (D-08). The Test Connection button calls ITestConnectionService.TestAsync; the Save
   button submits via OnSave EventCallback so Add and Edit can wire different repo paths.

   method="post": load-bearing for the SSR-fallback Save path (debug add-form-noninteractive,
   2026-05-09). Without it, the rendered <form> has no method and a no-circuit submit cannot
   round-trip to the SSR endpoint. Mirrors Login.razor's <EditForm method="post" FormName="login">
   pattern. The InteractiveServer circuit still intercepts submits when present. *@

<EditForm Model="Model" method="post" OnValidSubmit="HandleSaveAsync" FormName="node-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_testBanner))
    {
        <div class="alert alert-@_testBannerClass" role="alert">@_testBanner</div>
    }

    <div class="mb-3">
        <label class="form-label fw-semibold">Hostname or IP address</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-hdd-network"></i></span>
            <InputText class="form-control" placeholder="192.168.1.1" @bind-Value="Model.Hostname" />
        </div>
        <small class="form-text text-body-secondary">Reachable via SSH from this container.</small>
        <ValidationMessage For="@(() => Model.Hostname)" class="invalid-feedback d-block" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">SSH username</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <InputText class="form-control" placeholder="root" @bind-Value="Model.Username" />
        </div>
        <ValidationMessage For="@(() => Model.Username)" class="invalid-feedback d-block" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">SSH password</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
            <InputText type="password" class="form-control" @bind-Value="Model.Password"
                       placeholder="@(IsEdit ? "Leave blank to keep existing password" : "")" />
        </div>
        <small class="form-text text-body-secondary">
            @(IsEdit
                ? "Stored encrypted at rest. Leave blank to keep existing password."
                : "Stored encrypted at rest.")
        </small>
        <ValidationMessage For="@(() => Model.Password)" class="invalid-feedback d-block" />
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-primary" @onclick="HandleTestAsync" disabled="@_testing">
            @if (_testing)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Testing connection…</span>
            }
            else
            {
                <i class="bi bi-plug me-2"></i>
                <span>Test connection</span>
            }
        </button>

        <div>
            <a class="btn btn-link" href="/Nodes">Back to nodes</a>
            <button type="submit" class="btn btn-primary">@SaveLabel</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public NodeFormModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public bool IsEdit { get; set; }
    [Parameter] public int? ExistingNodeId { get; set; }
    [Parameter, EditorRequired] public EventCallback<NodeFormModel> OnSave { get; set; }

    private bool _testing;
    private string? _testBanner;
    private string _testBannerClass = "danger";
    private string SaveLabel => IsEdit ? "Save changes" : "Save node";

    private async Task HandleTestAsync()
    {
        _testing = true;
        _testBanner = null;
        try
        {
            if (string.IsNullOrEmpty(Model.Hostname) || string.IsNullOrEmpty(Model.Username))
            {
                _testBanner = "Fill hostname and username before testing.";
                _testBannerClass = "danger";
                return;
            }

            // D-08 / Specifics §"the encrypted ciphertext is NEVER decrypted on the Edit page":
            // in Edit mode with an empty password, surface a helper message instead of probing
            // (decrypting the stored ciphertext to test would breach SEC-01).
            if (IsEdit && string.IsNullOrEmpty(Model.Password))
            {
                _testBanner = "Type the current SSH password to test the connection. (Leaving the field blank on Save preserves the stored password.)";
                _testBannerClass = "info";
                return;
            }

            var outcome = await TestConnection.TestAsync(
                Model.Hostname!, Model.Username!, Model.Password ?? "",
                existingNodeId: ExistingNodeId,
                ct: CancellationToken.None);

            _testBanner = outcome.UserMessage;
            _testBannerClass = outcome.Severity switch
            {
                OutcomeSeverity.Success => "success",
                OutcomeSeverity.Info => "info",
                _ => "danger"
            };
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        await OnSave.InvokeAsync(Model);
    }
}
