@* ThemeToggle.razor — Phase 8 (REQ-UI-30..32, REQ-UI-51).

   Topbar sun/moon icon button that persists the theme to localStorage via
   PreferencesService and applies it via wwwroot/js/theme.js. Default follows
   `prefers-color-scheme` when no theme key is yet stored (REQ-UI-31).

   Markup contract LOCKED in 08-UI-SPEC.md §Components/Shared/ThemeToggle.razor:
     - aria-label flips between "Switch to dark mode" and "Switch to light mode"
     - icon swaps bi-sun-fill (light active) ↔ bi-moon-stars-fill (dark active)
     - 32×32px button (btn-sm + p-1), inner icon 1.1rem

   Lifecycle (CLAUDE.md / PITFALLS.md Pitfall 7):
     - localStorage / JS interop is FORBIDDEN inside OnInitialized / OnInitializedAsync
       (prerender HTML pass — no Blazor circuit yet, no JS bridge).
     - All localStorage reads happen in OnAfterRenderAsync(firstRender:true).
     - The `_restored` flag prevents re-restoration on subsequent renders (otherwise
       we'd flip the theme back every render).
     - After restore, explicit StateHasChanged() to re-render with the recovered state.

   The anti-FOUC inline script in App.razor (Plan 08-02) handles the synchronous
   pre-attach apply. THIS component owns in-session toggles after the circuit attaches. *@

@inject PreferencesService Prefs
@inject IJSRuntime JS
@using OpenWrtApStats.Services

<button type="button"
        class="btn btn-link btn-sm text-body p-1"
        aria-label="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
        title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
        @onclick="ToggleAsync">
    <i class="bi @(_isDark ? "bi-moon-stars-fill" : "bi-sun-fill")" style="font-size: 1.1rem;"></i>
</button>

@code {
    private bool _isDark;
    private bool _restored;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // PITFALLS.md Pitfall 7 — localStorage / JS interop is FORBIDDEN during prerender.
        // OnAfterRenderAsync(firstRender:true) is the ONLY safe place to call
        // PreferencesService methods. The _restored flag prevents re-restoration on
        // subsequent renders (otherwise we'd flip the theme back every render).
        if (!firstRender || _restored) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme.js");

            var theme = await Prefs.GetThemeAsync();
            if (string.IsNullOrEmpty(theme))
            {
                // No persisted preference yet — fall back to system preference (REQ-UI-31).
                theme = await _module.InvokeAsync<string>("getSystemPreference");
            }

            _isDark = string.Equals(theme, "dark", StringComparison.Ordinal);
            await _module.InvokeVoidAsync("applyTheme", _isDark ? "dark" : "light");
        }
        catch (JSException) { /* prerender or interop unavailable — fall through to default light */ }
        catch (InvalidOperationException) { /* Blazor not yet attached — same fallback */ }
        finally
        {
            _restored = true;
            StateHasChanged();
        }
    }

    private async Task ToggleAsync()
    {
        _isDark = !_isDark;
        var value = _isDark ? "dark" : "light";
        await Prefs.SetThemeAsync(value);
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("applyTheme", value); }
            catch (JSException) { /* interop racing — restore loop will recover */ }
        }
    }
}
