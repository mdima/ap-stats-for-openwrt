@* WizardBreadcrumb.razor — D-07 wizard chrome. Three-step breadcrumb with completed /
   current / future visual states. Bespoke Razor markup — AdminLTE 4 wizard-bs (RC7)
   is too unstable to use per STACK.md. *@

<div class="d-flex align-items-center justify-content-center gap-2 mb-4">

    @* Step 1: Password *@
    @if (CurrentStep > 1)
    {
        <a href="/setup/password" class="text-primary">1 Password</a>
    }
    else if (CurrentStep == 1)
    {
        <span class="fw-semibold text-body">1 Password</span>
    }
    else
    {
        <span class="text-body-secondary">1 Password</span>
    }

    <span class="text-body-secondary mx-2">&rsaquo;</span>

    @* Step 2: Nodes *@
    @if (CurrentStep > 2)
    {
        <a href="/setup/nodes" class="text-primary">2 Nodes</a>
    }
    else if (CurrentStep == 2)
    {
        <span class="fw-semibold text-body">2 Nodes</span>
    }
    else
    {
        <span class="text-body-secondary">2 Nodes</span>
    }

    <span class="text-body-secondary mx-2">&rsaquo;</span>

    @* Step 3: WLANs — no "completed" state; it is always the last step (WR-03) *@
    @if (CurrentStep == 3)
    {
        <span class="fw-semibold text-body">3 WLANs</span>
    }
    else
    {
        <span class="text-body-secondary">3 WLANs</span>
    }

</div>

@code {
    [Parameter, EditorRequired] public int CurrentStep { get; set; }
}
