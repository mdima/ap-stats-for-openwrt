@using OpenWrtApStats.Data.Models

@* StatusBadge.razor — UI-SPEC §Status Badges. Online/Offline pill. Phase 3 collapses
   Status.Polling to Online; Phase 5 may add a third variant. *@

@if (Status == OpenWrtApStats.Data.Models.Status.Online || Status == OpenWrtApStats.Data.Models.Status.Polling)
{
    <span class="badge text-bg-success"><i class="bi bi-circle-fill me-1"></i>Online</span>
}
else
{
    <span class="badge text-bg-secondary"><i class="bi bi-circle me-1"></i>Offline</span>
}

@code {
    [Parameter, EditorRequired] public OpenWrtApStats.Data.Models.Status Status { get; set; }
}
