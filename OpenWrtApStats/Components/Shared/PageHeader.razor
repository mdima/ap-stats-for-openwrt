@* PageHeader.razor — page-title block in MainLayout's app-content-header.
   Renders a <PageTitle> for the browser title and an <h3> in the content header. *@

<PageTitle>OpenWRT-AP-Stats — @Title</PageTitle>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@Title</h3>
    @if (HeaderActions is not null)
    {
        <div>@HeaderActions</div>
    }
</div>
@if (!string.IsNullOrEmpty(Description))
{
    <p class="text-body-secondary">@Description</p>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
}
