@* App.razor — Blazor root host. D-06: render mode is per-request, conditional on the
   matched endpoint. Pages with [ExcludeFromInteractiveRouting] (Login, Password) render
   static SSR; everything else renders InteractiveServer. The unconditional InteractiveServer
   pattern would let the client-side Router run on excluded pages and replace them with a
   "Not found" fallback after pre-render. UI-SPEC §Vendoring step 7+8 locks the <link> order
   (Source Sans 3 → Bootstrap Icons → AdminLTE) and <script> order (AdminLTE first, then
   blazor.web.js). *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="/lib/source-sans-3/index.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/lib/adminlte/css/adminlte.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <Routes @rendermode="@PageRenderMode" />
    @* Script load order is load-bearing:
       1. bootstrap.bundle.min.js — AdminLTE 4 RC7 hard-deps on "bootstrap": "^5.3.8";
          modals/dropdowns silently no-op without it (closed UAT 3.2 in 6bfdcb8).
       2. adminlte.min.js — wires its own data-lte-toggle="*" handlers at DOMContentLoaded.
       3. sidebar-toggle.js — project-owned document-delegated handler for the sidebar
          collapse, using attribute `data-app-toggle="sidebar"` so AdminLTE doesn't bind
          to the same node. Survives Blazor InteractiveServer remounts that AdminLTE's
          one-shot listener does not. Debug: .planning/debug/resolved/sidebar-toggle-no-collapse.md
       4. blazor.web.js — static-asset behaviour is in place before the Blazor runtime
          takes over the circuit. *@
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/adminlte/js/adminlte.min.js"></script>
    <script src="/js/sidebar-toggle.js"></script>
    <script src="/js/local-time.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting() ? RenderMode.InteractiveServer : null;
}
