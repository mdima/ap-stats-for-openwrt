<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ApStatsForOpenWrt'">
    <!-- Production code is held to warnings-as-errors. Test projects (any other MSBuildProjectName,
         e.g. ApStatsForOpenWrt.Tests) skip this PropertyGroup so warnings never fail their build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single source of truth for the displayed version. MainLayout.razor reads it via
         typeof(MainLayout).Assembly.GetName().Version?.ToString(3). <Version> sets
         AssemblyVersion, FileVersion, and InformationalVersion together; bump this one
         line when starting the next milestone (e.g. 0.9.0 -> 1.0.0). -->
    <Version>0.9.0</Version>
  </PropertyGroup>
</Project>
