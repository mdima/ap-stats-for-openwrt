<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OpenWrtApStats'">
    <!-- Production code is held to warnings-as-errors. Test projects (any other MSBuildProjectName,
         e.g. OpenWrtApStats.Tests) skip this PropertyGroup so warnings never fail their build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
