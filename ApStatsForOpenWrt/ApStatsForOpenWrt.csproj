<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApStatsForOpenWrt</RootNamespace>
    <AssemblyName>ApStatsForOpenWrt</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <DockerfileFile>..\Dockerfile</DockerfileFile>
    <!--
      Bug fix: blazor-js-404 (.planning/debug/resolved/blazor-js-404.md).

      Forces the .NET SDK's ProcessFrameworkReferences task to auto-include the
      `Microsoft.AspNetCore.App.Internal.Assets` NuGet package, which carries
      `_framework/blazor.web.js` (and blazor.server.js) into the publish output's
      wwwroot/_framework/ directory. Without this property, the SDK's auto-detect
      heuristic (look for *.razor in `Content` items at evaluation-of-targets time)
      fails for this project on the Linux SDK image, even though the project
      contains many *.razor files and uses `Microsoft.NET.Sdk.Razor` transitively.
      The result is that publish emits no _framework/ directory, the runtime serves
      a flat 404 for /_framework/blazor.web.js, no Blazor circuit ever forms, and
      every InteractiveServer page silently degrades to static SSR.

      We set the property explicitly here (instead of `/p:RequiresAspNetWebAssets=true`
      on the Dockerfile publish line) so host (Visual Studio) and Docker builds behave
      identically. The property is harmless on the host where the SDK already auto-
      detects Blazor; it is load-bearing in the Docker build.

      Cross-ref: app.MapStaticAssets() in Program.cs registers the endpoint route
      that serves the file produced here.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <Version>0.10.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow the test project to exercise internal types (e.g., SshAlgorithmFallbackPolicy)
         without forcing them public. Production callers within ApStatsForOpenWrt remain unaffected. -->
    <InternalsVisibleTo Include="ApStatsForOpenWrt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DASH-13 / D-21: IEEE OUI registry snapshot loaded by OuiLookup at startup. -->
    <EmbeddedResource Include="Data/Resources/oui.csv" />
  </ItemGroup>

  <!--
    VS Container Tools (Microsoft.VisualStudio.Azure.Containers.Tools.Targets) builds the image
    as `openwrtapstats:dev` by default. The "Local registry" publish profile uses
    DockerCustomContainerRegistry which does `docker tag openwrtapstats:latest <registry>/...`
    + push, so it requires an `openwrtapstats:latest` tag to exist locally — which the regular
    build does not produce. Without this target, Publish fails with
    "Error response from daemon: No such image: openwrtapstats:latest".

    AfterTargets="Build" Condition='$(Configuration) == Release': ensures the :latest alias
    is refreshed every Release build (the configuration Publish uses). ContinueOnError +
    IgnoreExitCode keep the build green if Docker isn't running or the :dev tag isn't there yet
    (e.g., very first build before Container Tools has produced anything).
  -->
  <Target Name="EnsureContainerLatestTag" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="docker tag openwrtapstats:dev openwrtapstats:latest" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>
</Project>
