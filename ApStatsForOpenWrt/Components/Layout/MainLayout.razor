@inherits LayoutComponentBase

@* MainLayout.razor — AdminLTE 4 fixed-sidebar chrome. UI-SPEC §MainLayout (lines 64-94).
   The Phase 6 anchor comment lives between sidebar-toggle and user-menu; do not move.
   The .app-wrapper div is REQUIRED — AdminLTE 4 RC drives layout via display:grid +
   grid-template-areas on this container. Without it, .app-sidebar falls back to
   position:fixed and overlaps .app-main; the header sits above content in normal flow. *@

<div class="app-wrapper">

<nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                @* Project-scoped attribute (NOT `data-lte-toggle="sidebar"`): AdminLTE 4 wires
                   its toggle once at DOMContentLoaded against the prerendered DOM, but Blazor's
                   interactive remount replaces this <button> and orphans the listener. The
                   document-delegated handler in /js/sidebar-toggle.js survives every remount.
                   Debug trail: .planning/debug/resolved/sidebar-toggle-no-collapse.md *@
                <button class="nav-link" type="button" data-app-toggle="sidebar" aria-label="Toggle sidebar">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </li>
        </ul>
        <ul class="navbar-nav ms-auto">
            @* Phase 5 D-12 / DASH-08: Live/Paused indicator + paired poll countdown.
               Adjacent pills (UI-SPEC line 615 LOCK — NOT a combined pill). The slot
               originally reserved by Phase 3 for "Phase 6" is claimed by Phase 5; Phase 6
               will swap the gate source (DI replacement of ICircuitGate impl) without
               touching this markup. Phase 8 (REQ-UI-31, 08-UI-SPEC §Topbar replacement)
               appends <ThemeToggle /> as the LAST child of the cluster.
               Phase 17 D-01 (M-UPD-03) inserts <UpdateBadge /> BETWEEN <PollCountdown />
               and <ThemeToggle />. The locked cluster order is now:
               LivePausedBadge -> PollCountdown -> UpdateBadge -> ThemeToggle. UpdateBadge is
               DOM-absent unless an upstream release is newer AND the toggle is on (D-02), so
               in steady state the cluster is visually identical to Phase 8. *@
            <li class="nav-item d-flex align-items-center gap-2 me-3">
                <LivePausedBadge />
                <PollCountdown />
                <UpdateBadge />
                <ThemeToggle />
            </li>
            <AuthorizeView>
                <Authorized>
                    <li class="nav-item d-flex  align-items-center gap-2">
                        <form action="/Logout" method="post" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Sign out
                            </button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    @* D-01: anonymous mode (UIPasswordHash null/empty) — user-menu HIDDEN. *@
                </NotAuthorized>
            </AuthorizeView>
        </ul>
    </div>
</nav>

<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
        @* Phase 8 (REQ-UI-70, D-14): branded SVG logo replaces the AdminLTE default
           PNG. Logo is currentColor-driven (REQ-UI-72), so it inherits the brand-link
           text color in both light and dark themes — NO color override here. The
           opacity-75/shadow classes from the AdminLTE default were removed for full
           clarity. Wordmark stays as HTML text per D-14. *@
        <a href="/" class="brand-link">
            <img src="/img/logo.svg" alt="AP Stats for OpenWrt logo"
                 class="brand-image" style="width: 32px; height: 32px;" />
            <span class="brand-text fw-semibold">AP Stats for OpenWrt</span>
        </a>
    </div>
    <div class="sidebar-wrapper">
        <NavMenu />
    </div>
</aside>

<main class="app-main">
    <div class="app-content-header">
        <div class="container-fluid">
            <h3 class="mb-0">@PageTitle</h3>
        </div>
    </div>
    <div class="app-content">
        <div class="container-fluid">
            @Body
        </div>
    </div>
</main>

<footer class="app-footer">
    <div class="container-fluid d-flex justify-content-between">
        <span><strong>AP Stats for OpenWrt</strong> v@(typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.0.0")</span>
        <span>
            <i class="bi bi-github"></i> <a class="" href="https://github.com/mdima/ap-stats-for-openwrt" target="_blank">GitHub</a>
        </span>
    </div>
</footer>

@* Phase 8 (REQ-UI-40, REQ-UI-44 / D-08): single ToastHost mount at the MainLayout
   body root, AFTER the app-main + app-footer block and BEFORE the .app-wrapper
   close. ToastHost.razor's container is position:fixed top-0 end-0, so DOM
   placement does not affect visual position — but mounting once here is the
   layout-singleton lockdown: every page rendered under MainLayout sees toasts
   without per-page mounts (which would duplicate the queue). *@
<ToastHost />

@* Phase 17 D-04 (M-UPD-04) — the one-shot discovery toast is emitted by the SINGLETON
   UpdateToastBroadcaster (Services/UpdateToastBroadcaster.cs), which subscribes to
   UpdateNotifier.UpdateAvailable ONCE per process and calls the singleton ToastService.Show
   exactly once per raise. The singleton ToastService then broadcasts the entry to EVERY
   circuit's ToastHost (the single mount above) for free. A per-circuit Blazor subscriber was
   rejected: with N open circuits it would call ToastService.Show N times per raise (N×N
   fan-out). The broadcaster mirrors EventDetectionService exactly (eager-started singleton). *@

</div>

@code {
    // PageTitle is rendered in the app-content-header h3. Pages set it via <PageHeader Title="..." />
    // which uses a CascadingValue/SectionOutlet pattern in a future plan; for the smoke spike
    // we render a static placeholder so MainLayoutTests can assert structure.
    [CascadingParameter] private string? PageTitle { get; set; }
}
