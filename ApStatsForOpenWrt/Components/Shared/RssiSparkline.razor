@* RssiSparkline.razor — Phase 19 M-HIST-06 (L-03 / L-05 / D-02 / D-03 / D-04).

   Inline per-station RSSI sparkline: SERVER-RENDERED SVG, ZERO JS interop (L-01). Pure
   parameter→markup shape (mirrors StatusBadge.razor — no lifecycle DI, no Cycled subscription;
   Blazor's render diff updates it when the parent re-renders on Cycled).

   Construction (RESEARCH §Pattern 3):
     - fixed viewBox="0 0 100 22" + preserveAspectRatio="none" so the path scales to the ~90×20 CSS box.
     - one <polyline> per contiguous run of present points; a gap (null Rssi) splits the line into
       separate segments (L-05 — offline/zero-row bucket = a visible break, distinct from a roam).
     - x = bucketIndex / (count-1) * 100.
     - stroke="currentColor" (D-02 — inherits --bs-body-color in both themes, no JS), line-only (no fill).
     - vector-effect="non-scaling-stroke" keeps the 1.5px stroke crisp despite the none aspect ratio.
   Zero present points → em-dash span (D-03), no <svg>.

   QUAL-02 sparkline enhancements (operator-requested 2026-06-02):
     - #4 auto-scale — the Y domain tracks THIS series' own min/max (padded, with a span floor) instead
       of the old fixed −90..−30 that squashed real variation into ~1–2px. Each row reads on its own scale.
     - #3 QUALITY TIERS — green/yellow/red bands (good ≥ −67 dBm, fair −67…−80, weak < −80) projected
       through the SAME auto-scaled domain. A band renders wherever the visible window overlaps its dBm
       range, so a steady station shows ONE colour and a station that CROSSES a tier boundary in-window
       shows BOTH adjacent colours, split exactly at the boundary's auto-scaled y.
     - #1 hover tooltip — a BOOTSTRAP tooltip (data-bs-toggle="tooltip" + data-bs-title on the
       wrapping <span>, initialized by the parent Dashboard's bs-tooltips.js call — NOT a native SVG
       <title>) with the latest reading, its tier word (good/fair/weak — so quality survives
       colour-blindness), and the window's range. The component stays ZERO-JS (L-01): it only EMITS
       the opt-in attribute; the parent owns the initializer.
     - #5 click-through is the PARENT's job (Dashboard wraps the cell in an /Stations/{mac} link) — not here.

   Both the column header and per-row cell are gated on Settings.HistoryEnabled by the PARENT
   (Dashboard.razor) — this component renders only when handed Points (D-04). *@

@using ApStatsForOpenWrt.Data.Repositories.History

@if (_segments.Count == 0)
{
    @* D-03 — no present points (MAC absent from the map, or all-gap window). *@
    <span class="text-body-secondary" aria-label="No history yet">—</span>
}
else
{
    @* #1 — Bootstrap tooltip opt-in on a WRAPPING span (latest + tier word + range). The attributes
       go on the span, NOT the bare <svg> (Bootstrap tooltips are finicky attached directly to SVG).
       data-bs-title is Bootstrap's canonical title attribute, so the browser does NOT also show a
       native title balloon. The parent Dashboard's bs-tooltips.js initializes the instance. *@
    <span class="rssi-sparkline-wrap" style="display:inline-flex"
          data-bs-toggle="tooltip" data-bs-title="@_title">
        <svg viewBox="0 0 100 22" preserveAspectRatio="none" width="90" height="20"
             role="img" aria-label="RSSI trend, last ~1 hour" class="rssi-sparkline">
            @* #3 quality tiers — green/yellow/red bands behind the line, clamped to the auto-scaled domain. *@
            @foreach (var band in _bands)
            {
                <rect class="rssi-sparkline-tier" x="0" y="@band.Y" width="100" height="@band.H" fill="@band.Fill" />
            }
            @foreach (var seg in _segments)
            {
                <polyline fill="none" stroke="currentColor" stroke-width="1.5"
                          vector-effect="non-scaling-stroke" points="@seg" />
            }
        </svg>
    </span>
}

@code {
    /// <summary>The Plan 02 per-MAC sparkline points (ascending; null Rssi == gap/offline bucket, L-05).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<RssiSparklinePoint> Points { get; set; } = [];

    // Fixed viewBox (RESEARCH §Pattern 3).
    private const double VbWidth = 100d;
    private const double VbHeight = 22d;

    // #4 auto-scale knobs: pad the series extremes, then floor the span so a near-flat trace isn't
    // amplified into meaningless noise.
    private const double Pad = 2d;       // dBm above/below the series min/max
    private const double MinSpan = 8d;   // dBm — minimum visible domain span

    // #3 quality-tier thresholds (dBm).
    private const int GoodFloorDbm = -67;   // ≥ −67 → good (green)
    private const int FairFloorDbm = -80;   // −80…−67 → fair (yellow); < −80 → weak (red)

    // Bootstrap success / warning / danger — alpha tuned for the tiny ~90×20 cell (higher than the
    // detail chart's .07/.10 zones, which read fine at full chart size; these are decoupled on purpose).
    private const string TintGood = "rgba(25,135,84,.12)";
    private const string TintFair = "rgba(255,193,7,.16)";
    private const string TintWeak = "rgba(220,53,69,.12)";

    private const double BandEpsilon = 0.05d; // sub-pixel bands aren't worth an element.

    // One "x,y x,y …" string per contiguous run of present points (gaps split the line).
    private List<string> _segments = new();

    // #3 tier bands (only those with visible height under the current scale), back-to-front.
    private List<TierBand> _bands = new();

    // #1 tooltip text.
    private string? _title;

    private readonly record struct TierBand(string Fill, string Y, string H);

    protected override void OnParametersSet()
    {
        var present = new List<int>();
        foreach (var p in Points)
        {
            if (p.Rssi is int r) present.Add(r);
        }

        if (present.Count == 0)
        {
            // D-03 — no present samples; render the em-dash, no bands/title.
            _segments = new();
            _bands = new();
            _title = null;
            return;
        }

        // #4 — auto-scale the Y domain to THIS series' own range. Pad the extremes, then enforce a
        // minimum span so a steady trace doesn't get blown up into full-scale jitter.
        double lo = present.Min() - Pad;
        double hi = present.Max() + Pad;
        if (hi - lo < MinSpan)
        {
            var mid = (hi + lo) / 2d;
            lo = mid - MinSpan / 2d;
            hi = mid + MinSpan / 2d;
        }

        _segments = BuildSegments(Points, lo, hi);
        _bands = BuildTierBands(lo, hi);

        // #1 — tooltip: latest reading + tier word (colour-blind-safe) + the window's range.
        var latest = LatestPresent(Points);
        _title = $"Latest {latest} dBm ({TierOf(latest)}) · range {present.Min()}…{present.Max()} dBm";
    }

    // #3 — green/yellow/red horizontal bands clamped to the auto-scaled [lo, hi] domain. Because every
    // band shares the line's domain, a band shows only where the window overlaps its dBm range: a steady
    // station yields ONE band; a station crossing −67 (or −80) in-window yields BOTH adjacent bands,
    // split at the boundary's y. yGood/yFair are the boundary y's; green runs from the viewBox top down
    // to −67, weak runs from −80 down to the viewBox bottom.
    private static List<TierBand> BuildTierBands(double lo, double hi)
    {
        var yGood = YOf(GoodFloorDbm, lo, hi);   // good/fair boundary (−67)
        var yFair = YOf(FairFloorDbm, lo, hi);   // fair/weak boundary (−80) — yFair >= yGood always

        var bands = new List<TierBand>(3);
        AddBand(bands, TintGood, 0d, yGood);         // ≥ −67 : top → −67 line
        AddBand(bands, TintFair, yGood, yFair);      // −80…−67
        AddBand(bands, TintWeak, yFair, VbHeight);   // < −80 : −80 line → bottom
        return bands;
    }

    private static void AddBand(List<TierBand> bands, string fill, double yTop, double yBot)
    {
        var h = yBot - yTop;
        if (h > BandEpsilon)
        {
            bands.Add(new TierBand(fill, Fmt(yTop), Fmt(h)));
        }
    }

    // RSSI reading → quality-tier word.
    private static string TierOf(int rssi) =>
        rssi >= GoodFloorDbm ? "good" : rssi >= FairFloorDbm ? "fair" : "weak";

    // Chronologically-last present reading (points are ascending; only called with ≥1 present point).
    private static int LatestPresent(IReadOnlyList<RssiSparklinePoint> points)
    {
        for (var i = points.Count - 1; i >= 0; i--)
        {
            if (points[i].Rssi is int r) return r;
        }
        return 0; // unreachable
    }

    // dBm → viewBox Y over [lo, hi]: higher RSSI = nearer the top = smaller y, clamped.
    private static double YOf(double v, double lo, double hi)
    {
        var norm = Math.Clamp((v - lo) / (hi - lo), 0d, 1d);
        return VbHeight * (1d - norm);
    }

    private static List<string> BuildSegments(IReadOnlyList<RssiSparklinePoint> points, double lo, double hi)
    {
        var segments = new List<string>();
        if (points.Count == 0) return segments;

        // x maps by bucket INDEX across the full point set (gaps still consume an x slot so the
        // horizontal time axis stays linear). Single point → divide-by-zero guard pins x=0.
        var span = points.Count > 1 ? points.Count - 1 : 1;

        var current = new System.Text.StringBuilder();
        var hasCurrent = false;

        void Flush()
        {
            if (hasCurrent && current.Length > 0)
            {
                segments.Add(current.ToString().TrimEnd());
            }
            current.Clear();
            hasCurrent = false;
        }

        for (var i = 0; i < points.Count; i++)
        {
            var rssi = points[i].Rssi;
            if (rssi is null)
            {
                Flush();   // gap — end the current run
                continue;
            }

            var x = (double)i / span * VbWidth;
            var y = YOf(rssi.Value, lo, hi);

            current.Append(Fmt(x)).Append(',').Append(Fmt(y)).Append(' ');
            hasCurrent = true;
        }
        Flush();

        return segments;
    }

    // Invariant-culture, trimmed numeric formatting so the points string is stable + locale-safe.
    private static string Fmt(double v) =>
        Math.Round(v, 2).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
