@* KpiHistoryChart.razor — Phase 19 M-HIST-05 (L-03 / L-07 / D-02 / D-03).

   The dashboard KPI stacked-bar history chart, mounted as a SIBLING directly beneath
   <KpiTileBar> (NOT nested — L-04). Online/Stale/Offline segments over the last 12 h in
   5-min buckets (≤144 bars), Chart.js via the project-owned chart-interop.js seam, hover-
   tooltips with exact counts (L-07). HIDDEN entirely by the parent when Settings.HistoryEnabled
   is false (the parent gates the <KpiHistoryChart> with an @if — D-03 "feature off → surface
   absent"); this component owns only the empty-DATA placeholder.

   Lifecycle discipline (RESEARCH §Pattern 1 + Detail.razor W4 double-guard; CLAUDE.md / Pitfall 1 + 7):
     - Subscribe Notifier.Cycled in OnInitialized — NO interop here (interop is FORBIDDEN during prerender).
     - Import chart-interop.js + first render ONLY in OnAfterRenderAsync(firstRender).
     - Re-query + updateKpiChart on Cycled, wrapped in await InvokeAsync(...) (Pitfall 7); handler returns Task.
     - DisposeAsync sets _disposed = true FIRST (paired-adjacency W4 invariant), unsubscribes, then
       destroyChart + module dispose inside try/catch.
     - Empty DTO (zero rows) → "Collecting history…" placeholder instead of an empty axes frame (D-03). *@

@implements IAsyncDisposable
@inject IKpiHistoryQueryService Kpi
@inject IJSRuntime JS
@inject PollNotifier Notifier
@using ApStatsForOpenWrt.Data.Repositories.History
@using ApStatsForOpenWrt.Services.Polling
@using Microsoft.JSInterop

<div class="card mb-3">
    <div class="card-header py-2 px-3">
        <h6 class="card-sub-title mb-0">Activity — last 12 h</h6>
    </div>
    <div class="card-body p-3">
        @if (_data is null || _data.IsEmpty)
        {
            @* D-03 zero-rows placeholder — NOT an empty axes frame. *@
            <p class="text-body-secondary mb-0">Collecting history…</p>
        }
        else
        {
            <div style="position: relative; height: 220px;">
                <canvas id="@_canvasId"></canvas>
            </div>
        }
    </div>
</div>

@code {
    // Per-instance canvas id so multiple charts on a page never collide (RESEARCH §Pattern 1).
    private readonly string _canvasId = $"kpi-history-{Guid.NewGuid():N}";
    private IJSObjectReference? _interop;

    // W4 race-with-dispose guard (Detail.razor:270). Set true FIRST in DisposeAsync, BEFORE
    // detaching the subscription, so a concurrent Cycled handler short-circuits before touching
    // the torn-down renderer (paired-adjacency invariant).
    private volatile bool _disposed;

    private KpiHistoryDto? _data;

    // Subscribe in OnInitialized (L-09) — NO interop (Pitfall 1: forbidden during prerender).
    protected override void OnInitialized()
    {
        Notifier.Cycled += OnCycledAsync;
    }

    // Interop ONLY here (RESEARCH §Pattern 1 / Pitfall 1). Import the seam + first render on the
    // first render only. The import mirrors the PreferencesService lazy-import idiom but the cache
    // field is enough here (single component lifetime; OnAfterRenderAsync(firstRender) runs once).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !firstRender) return;

        try
        {
            _interop = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart-interop.js");
        }
        catch (JSException) { return; }                 // prerender / interop unavailable
        catch (InvalidOperationException) { return; }   // prerender (no JS runtime yet)
        catch (TaskCanceledException) { return; }

        _data = await Kpi.GetLast12hAsync(CancellationToken.None);
        if (_disposed) return;

        // Re-render to swap the placeholder for the <canvas> when data exists, THEN render the chart.
        StateHasChanged();
        if (_interop is not null && _data is not null && !_data.IsEmpty)
        {
            try { await _interop.InvokeVoidAsync("renderKpiChart", _canvasId, ToInterop(_data)); }
            catch (JSException) { }
            catch (ObjectDisposedException) { }
        }
    }

    // Cycled handler — returns Task (NOT async void, Pitfall 7). Re-query then mutate inside
    // InvokeAsync (the handler arrives off the circuit's sync-context). W4: short-circuit on dispose.
    private async Task OnCycledAsync(PollSnapshot _)
    {
        if (_disposed) return;
        var data = await Kpi.GetLast12hAsync(CancellationToken.None);
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                _data = data;
                StateHasChanged();
                if (_interop is not null && _data is not null && !_data.IsEmpty)
                {
                    try { await _interop.InvokeVoidAsync("updateKpiChart", _canvasId, ToInterop(_data)); }
                    catch (JSException) { }
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // W4 race between Cycled raise and DisposeAsync — renderer gone, swallow.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;                       // W4: set FIRST (paired adjacency)
        Notifier.Cycled -= OnCycledAsync;
        if (_interop is not null)
        {
            try { await _interop.InvokeVoidAsync("destroyChart", _canvasId); } catch { }
            try { await _interop.DisposeAsync(); } catch { }
        }
    }

    // Project the typed DTO into the flat shape chart-interop.js consumes
    // ({ labels, online[], stale[], offline[] }). Gaps (null counts) pass through as null so
    // Chart.js leaves the bar empty for that bucket (D-03).
    private static object ToInterop(KpiHistoryDto dto) => new
    {
        labels  = dto.Buckets.Select(b => b.BucketUtc.ToString("HH:mm")).ToArray(),
        online  = dto.Buckets.Select(b => b.OnlineCount).ToArray(),
        stale   = dto.Buckets.Select(b => b.StaleCount).ToArray(),
        offline = dto.Buckets.Select(b => b.OfflineCount).ToArray(),
    };
}
