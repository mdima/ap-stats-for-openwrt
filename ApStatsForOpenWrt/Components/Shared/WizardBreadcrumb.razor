@* WizardBreadcrumb.razor — D-07 wizard chrome. Four-step breadcrumb with completed /
   current / future visual states. Bespoke Razor markup — AdminLTE 4 wizard-bs (RC7)
   is too unstable to use per STACK.md.
   19-05 (D-01): extended 3→4 steps (1 Password › 2 Nodes › 3 WLANs › 4 History).
   The WR-03 "always-last" invariant shifts from WLANs to History; WLANs now gains a
   completed/clickable-link state when CurrentStep > 3. *@

<div class="d-flex align-items-center justify-content-center gap-2 mb-4">

    @* Step 1: Password *@
    @if (CurrentStep > 1)
    {
        <a href="/setup/password" class="text-primary">1 Password</a>
    }
    else if (CurrentStep == 1)
    {
        <span class="fw-semibold text-body">1 Password</span>
    }
    else
    {
        <span class="text-body-secondary">1 Password</span>
    }

    <span class="text-body-secondary mx-2">&rsaquo;</span>

    @* Step 2: Nodes *@
    @if (CurrentStep > 2)
    {
        <a href="/setup/nodes" class="text-primary">2 Nodes</a>
    }
    else if (CurrentStep == 2)
    {
        <span class="fw-semibold text-body">2 Nodes</span>
    }
    else
    {
        <span class="text-body-secondary">2 Nodes</span>
    }

    <span class="text-body-secondary mx-2">&rsaquo;</span>

    @* Step 3: WLANs — gains a completed/clickable state when CurrentStep > 3 (D-01) *@
    @if (CurrentStep > 3)
    {
        <a href="/setup/wlans" class="text-primary">3 WLANs</a>
    }
    else if (CurrentStep == 3)
    {
        <span class="fw-semibold text-body">3 WLANs</span>
    }
    else
    {
        <span class="text-body-secondary">3 WLANs</span>
    }

    <span class="text-body-secondary mx-2">&rsaquo;</span>

    @* Step 4: History — no "completed" state; it is always the last step (WR-03, D-01) *@
    @if (CurrentStep == 4)
    {
        <span class="fw-semibold text-body">4 History</span>
    }
    else
    {
        <span class="text-body-secondary">4 History</span>
    }

</div>

@code {
    [Parameter, EditorRequired] public int CurrentStep { get; set; }
}
