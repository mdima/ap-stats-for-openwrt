@* ToastHost.razor — Phase 8 (REQ-UI-40, REQ-UI-43, REQ-UI-44).

   Bootstrap 5 toast container, mounted once at MainLayout body root in Wave 3 Plan 09.
   Subscribes to ToastService.OnShow in OnInitialized; unsubscribes in Dispose
   (CLAUDE.md / PITFALLS.md Pitfall 7 subscription discipline).

   Markup contract LOCKED in 08-UI-SPEC.md §Components/Shared/ToastHost.razor.
   Container styling LOCKED (REQ-UI-40 verbatim):
     - position: fixed; top: 1rem; right: 1rem (Bootstrap shorthand: top-0 end-0 p-3)
     - z-index: 1090 (above Bootstrap modal at 1055 — non-blocking informational overlay)
     - aria-live="polite" aria-atomic="true"
     - mb-2 between toast cards

   Queue contract LOCKED (REQ-UI-43):
     - FIFO with cap 5 (MaxQueue)
     - 6th arrival drops oldest synchronously BEFORE adding new entry (no animation crossfade)
     - 5000ms auto-dismiss via C# Task.Delay + per-entry CancellationTokenSource (NOT
       Bootstrap data-bs-autohide — pure C# timer for testability per 08-UI-SPEC §Anatomy)
     - Manual dismiss cancels the auto-dismiss CTS for that entry

   Severity → Bootstrap class + Bootstrap Icon mapping (LOCKED — 08-UI-SPEC §Anatomy table):
     - info    → text-bg-info     + bi-info-circle-fill
     - success → text-bg-success  + bi-check-circle-fill
     - warning → text-bg-warning  + bi-exclamation-triangle-fill
     - danger  → text-bg-danger   + bi-x-octagon-fill

   XSS guard (T-08-16): @t.Title and @t.Message use Blazor's default HTML-encoding.
   NEVER substitute @((MarkupString)t.Message) — that would be an XSS vector since
   EventDetectionService interpolates user-supplied AP hostnames and SSIDs (sourced from
   the SSH parser of remote OpenWRT devices) into the message strings.

   D-10 defense-in-depth: gating happens upstream in ToastService.Show; this component
   has no gating logic of its own. *@

@inject ToastService Toasts
@implements IDisposable
@using ApStatsForOpenWrt.Services

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;"
     aria-live="polite" aria-atomic="true">
    @foreach (var t in _queue)
    {
        <div class="toast show align-items-center text-bg-@t.Severity border-0 mb-2"
             role="@(t.Severity == "danger" ? "alert" : "status")"
             id="@($"toast-{t.Id}")">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi @IconFor(t.Severity) me-2" aria-hidden="true"></i>
                    <strong>@t.Title</strong>
                    <span class="ms-1">@t.Message</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        aria-label="Dismiss" @onclick="() => DismissAsync(t.Id)"></button>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxQueue = 5;
    private const int AutoDismissMs = 5000;

    private readonly LinkedList<ToastEntry> _queue = new();
    private readonly Dictionary<Guid, CancellationTokenSource> _timers = new();

    protected override void OnInitialized() => Toasts.OnShow += HandleShow;

    public void Dispose()
    {
        Toasts.OnShow -= HandleShow;
        foreach (var cts in _timers.Values)
        {
            try
            {
                cts.Cancel();
                cts.Dispose();
            }
            catch
            {
                // Best-effort dispose during teardown — never throw.
            }
        }
        _timers.Clear();
    }

    private async Task HandleShow(ToastEntry entry)
    {
        // FIFO drop-oldest BEFORE adding the new entry (REQ-UI-43). Synchronous so the
        // 6th render frame shows the new toast in place of the oldest with no crossfade.
        if (_queue.Count >= MaxQueue && _queue.First is { } oldest)
        {
            _queue.RemoveFirst();
            if (_timers.Remove(oldest.Value.Id, out var staleCts))
            {
                try
                {
                    staleCts.Cancel();
                    staleCts.Dispose();
                }
                catch
                {
                    // Best-effort.
                }
            }
        }
        _queue.AddLast(entry);

        // Schedule auto-dismiss via per-entry CTS so manual dismiss can cancel it.
        var cts = new CancellationTokenSource();
        _timers[entry.Id] = cts;
        _ = AutoDismissAsync(entry.Id, cts.Token);

        await InvokeAsync(StateHasChanged);
    }

    private async Task AutoDismissAsync(Guid id, CancellationToken ct)
    {
        try
        {
            await Task.Delay(AutoDismissMs, ct);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        await DismissAsync(id);
    }

    private async Task DismissAsync(Guid id)
    {
        var node = _queue.First;
        while (node is not null)
        {
            if (node.Value.Id == id)
            {
                _queue.Remove(node);
                break;
            }
            node = node.Next;
        }
        if (_timers.Remove(id, out var cts))
        {
            try
            {
                cts.Cancel();
                cts.Dispose();
            }
            catch
            {
                // Best-effort.
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string IconFor(string severity) => severity switch
    {
        "info"    => "bi-info-circle-fill",
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "danger"  => "bi-x-octagon-fill",
        _         => "bi-info-circle-fill",
    };
}
