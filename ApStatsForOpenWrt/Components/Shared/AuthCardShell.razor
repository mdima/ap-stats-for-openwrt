@* AuthCardShell.razor — Phase 16 v0.12 polish. Shared "auth card" layout shell used by
   BOTH LoginLayout and SetupLayout so the login page and the onboarding wizard share the
   same wizard-style chrome (operator-approved "Shared wizard-style layout").

   Owns the common chrome only:
     - outer .login-page bg-body-secondary
     - a centered box whose class/style the caller controls (login-box vs setup-wizard-box)
     - the .login-logo with the CANONICAL brand "AP Stats for OpenWrt"
     - an optional @AboveCard slot (wizard breadcrumb)
     - the .card / .card-body wrapper around @ChildContent
     - an optional @BelowCard slot (wizard "Skip for now" form + helper text)

   Layout-only: no auth logic, no rate-limiting, no wizard step logic lives here. *@

<div class="login-page bg-body-secondary">
    <div class="@BoxClass" style="@BoxStyle">
        <div class="login-logo mb-4">
            <a href="/"><strong>AP Stats</strong> for OpenWrt</a>
        </div>

        @AboveCard

        <div class="card">
            <div class="card-body">
                @ChildContent
            </div>
        </div>

        @BelowCard
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? AboveCard { get; set; }
    [Parameter] public RenderFragment? BelowCard { get; set; }
    [Parameter] public string BoxClass { get; set; } = "login-box";
    [Parameter] public string? BoxStyle { get; set; }
}
