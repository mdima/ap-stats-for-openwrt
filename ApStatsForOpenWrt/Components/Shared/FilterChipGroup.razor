@* FilterChipGroup.razor — Phase 5 D-06 / DASH-06. UI-SPEC §FilterChipGroup (lines 833-857).
   Two instances on Dashboard: SSID + AP. Compose semantics: OR within group, AND across
   groups (the parent Dashboard composes the predicates against _rows). Empty Options
   renders only the title (UI-SPEC line 857 — communicates "filter exists but no values").

   Phase 8 D-18 / REQ-UI-11 EXTENSION: optional `StatusBadgeFor` parameter. When null
   (default), the chip renders unchanged — full retro-compatibility for the SSID + Status
   instances. When non-null, each chip's <button> renders a nested <StatusBadge> after
   the label text via `ms-1` (4px) gap. Reuses Phase 5's StatusBadge mapping verbatim
   (Status.Online → text-bg-success, Status.Offline → text-bg-secondary,
   Status.Offline + IsStale → text-bg-warning). BadgeState.Hidden suppresses the badge
   for that chip (allows partial coverage when an AP's status is unknown). *@

<div class="filter-chip-group d-inline-flex align-items-center gap-1 me-4 mb-1"
     role="group" aria-label="@($"Filter by {Title}")">
    <label class="small text-body-secondary me-1 filterLabel">@Title:</label>
    @foreach (var opt in Options)
    {
        var selected = Selected.Contains(opt);
        <button type="button"
                class="btn btn-sm @(selected ? "btn-secondary" : "btn-outline-secondary")"
                aria-pressed="@selected.ToString().ToLowerInvariant()"
                @onclick="() => OnToggled.InvokeAsync(opt)">
            @opt
            @if (StatusBadgeFor is { } fn)
            {
                var state = fn(opt);
                if (state != BadgeState.Hidden)
                {
                    <span class="ms-1">
                        @switch (state)
                        {
                            case BadgeState.Online:
                                <StatusBadge Status="ApStatsForOpenWrt.Data.Models.Status.Online" IsStale="false" />
                                break;
                            case BadgeState.Offline:
                                <StatusBadge Status="ApStatsForOpenWrt.Data.Models.Status.Offline" IsStale="false" />
                                break;
                            case BadgeState.Stale:
                                <StatusBadge Status="ApStatsForOpenWrt.Data.Models.Status.Offline" IsStale="true" />
                                break;
                        }
                    </span>
                }
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<string> Options { get; set; } = Array.Empty<string>();
    [Parameter, EditorRequired] public HashSet<string> Selected { get; set; } = new();
    [Parameter] public EventCallback<string> OnToggled { get; set; }

    /// <summary>Phase 8 REQ-UI-11. Optional per-chip status badge resolver. When null
    /// (default), the chip renders identically to Phase 5 — full retro-compatibility for
    /// the SSID and Status instances on Dashboard. When non-null, each chip's <button>
    /// renders a nested <StatusBadge> after the label via <c>ms-1</c> (4px) gap.</summary>
    [Parameter] public Func<string, BadgeState>? StatusBadgeFor { get; set; }

    /// <summary>Phase 8 REQ-UI-11. Per-chip status badge variant. <c>Hidden</c> suppresses
    /// the badge for that chip (partial coverage when an AP's status is unknown).</summary>
    public enum BadgeState
    {
        Online,
        Offline,
        Stale,
        Hidden,
    }
}
