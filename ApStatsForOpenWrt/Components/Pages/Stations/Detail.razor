@page "/Stations/{Mac}"
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using ApStatsForOpenWrt.Data.Models
@using ApStatsForOpenWrt.Data.Repositories
@using ApStatsForOpenWrt.Services.Polling
@using ApStatsForOpenWrt.Services.Settings
@using ApStatsForOpenWrt.Services.Vendor

@inject IStationRepo Stations
@inject INodeRepo Nodes
@inject INetworkRepo Networks
@inject IOuiLookup Oui
@inject IAppSettingsService Settings
@inject NavigationManager Nav
@inject ApStatsForOpenWrt.Services.EventDetectionService Events
@* v0.11 Plan 14-04 DISC-01..07 -- write-side SSH disconnect path. *@
@inject ApStatsForOpenWrt.Services.Admin.INodeAdminService NodeAdmin
@inject ILogger<ApStatsForOpenWrt.Components.Pages.Stations.Detail> Log
@* 260516-dlu — live-update subscription so the page reflects DB-side changes
   (notably post-Disconnect Offline transitions) without manual navigation/F5. *@
@inject PollNotifier Notifier

@* Stations/Detail.razor — Phase 5 D-13 / DASH-15 / DASH-14 / DASH-16. UI-SPEC §Layout
   Contracts §/Stations/{mac} (lines 244-316), §Component Contracts §Detail Page (lines
   764-823). Two-column responsive AdminLTE card layout. Read-only fields left, edit
   Name + Delete trigger right. Reuses Phase 3 ConfirmationModal verbatim for D-14
   (PATTERNS.md "Decision: prefer direct reuse over wrapper").

   v0.11 / Quick task 260516-dlu (amends Phase 5 UI-SPEC line 947 'snapshot' framing):
   the page subscribes to PollNotifier.Cycled in OnInitializedAsync and re-runs
   LoadAsync on every successful cycle, then unsubscribes in Dispose with W4 double-
   guard (volatile _disposed flag + try/catch around InvokeAsync) mirroring
   PollCountdown.razor's disposal discipline verbatim. Triggered by the v0.11 QUAL-02
   LIVE-UAT operator-side request 2026-05-16 ('after the disconnection I expect that
   the station data will be updated as reported offline'). The optimistic Offline flip
   on DisconnectResult.Success below complements the subscription -- instant feedback,
   then the next real Cycled converges authoritatively against the DB. *@

<PageHeader Title="@DisplayName" />

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border" role="status" aria-label="Loading station"></div>
    </div>
}
else if (_station is null)
{
    @* 404 state per UI-SPEC §Detail Page 404 lines 794-799. *@
    <EmptyState IconClass="bi-search"
                Heading="Station not found"
                Body="No station with that MAC has been seen on a monitored WLAN."
                CtaLabel="Back to dashboard"
                CtaHref="/"
                CtaIconClass="bi-arrow-left" />
}
else
{
    <div class="row g-3">
        @* LEFT col-lg-7: read-only station details *@
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><h5 class="card-title mb-0">Station details</h5></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">MAC</dt>
                        <dd class="col-sm-8"><code class="font-monospace">@_station.MacAddress</code></dd>

                        <dt class="col-sm-4">Hostname</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(_station.Hostname) ? "—" : _station.Hostname)</dd>

                        <dt class="col-sm-4">Vendor</dt>
                        <dd class="col-sm-8">@(_vendor ?? "Unknown vendor")</dd>

                        <dt class="col-sm-4">IP address</dt>
                        <dd class="col-sm-8"><code class="font-monospace">@(string.IsNullOrEmpty(_station.IPAddress) ? "—" : _station.IPAddress)</code></dd>

                        <dt class="col-sm-4">SSID</dt>
                        <dd class="col-sm-8">@(_network?.SSID ?? "—")</dd>

                        <dt class="col-sm-4">Access point</dt>
                        <dd class="col-sm-8">@(_apHostname ?? "—")</dd>

                        <dt class="col-sm-4">Tx bitrate</dt>
                        <dd class="col-sm-8">@(_station.TxBitrate > 0 ? FormatBitrate(_station.TxBitrate) : "—")</dd>

                        <dt class="col-sm-4">Rx bitrate</dt>
                        <dd class="col-sm-8">@(_station.RxBitrate > 0 ? FormatBitrate(_station.RxBitrate) : "—")</dd>

                        <dt class="col-sm-4">Signal</dt>
                        <dd class="col-sm-8"><RssiCell Rss="_station.RSS" /></dd>

                        <dt class="col-sm-4">First seen</dt>
                        <dd class="col-sm-8">
                            @RelativeTime(_station.FirstSeen)
                            @* v0.9.2 — mirrors the "Last seen" markup verbatim. /js/local-time.js
                               rewrites the <time> textContent into the browser's local timezone via
                               toLocaleString(). UTC ISO 8601 in the datetime attribute is the source
                               of truth; the inner text is only the no-JS fallback so view-source
                               still shows a reasonable value. *@
                            <small class="text-body-secondary">
                                (<time datetime="@(DateTime.SpecifyKind(_station.FirstSeen, DateTimeKind.Utc).ToString("o"))"
                                       data-local-time>@DateTime.SpecifyKind(_station.FirstSeen, DateTimeKind.Utc).ToString("u")</time>)
                            </small>
                        </dd>

                        <dt class="col-sm-4">Last seen</dt>
                        <dd class="col-sm-8">
                            @RelativeTime(_station.LastPollDate)
                            @* /js/local-time.js rewrites the <time> textContent into the browser's
                               local timezone via toLocaleString(). UTC ISO 8601 in the datetime
                               attribute is the source of truth; the inner text is only the
                               no-JS fallback so view-source still shows a reasonable value. *@
                            <small class="text-body-secondary">
                                (<time datetime="@(DateTime.SpecifyKind(_station.LastPollDate, DateTimeKind.Utc).ToString("o"))"
                                       data-local-time>@DateTime.SpecifyKind(_station.LastPollDate, DateTimeKind.Utc).ToString("u")</time>)
                            </small>
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8"><StatusBadge Status="_station.Status" IsStale="@_isStale" /></dd>
                    </dl>
                </div>
            </div>
        </div>

        @* RIGHT col-lg-5: edit Name + Delete trigger *@
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><h5 class="card-title mb-0">Manage</h5></div>
                <div class="card-body">
                    <EditForm Model="_form" OnValidSubmit="HandleSaveNameAsync" FormName="station-name-form">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label" for="station-name">Display name</label>
                            <InputText id="station-name" class="form-control" @bind-Value="_form.Name" maxlength="64" />
                            <ValidationMessage For="@(() => _form.Name)" class="invalid-feedback d-block" />
                            <small class="form-text text-body-secondary">Leave blank to fall back to hostname or MAC.</small>
                        </div>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving…</span>
                            }
                            else
                            {
                                <span>Save name</span>
                            }
                        </button>
                        @if (_savedFlash) { <small class="text-success ms-2">Saved</small> }
                    </EditForm>

                    @* Phase 10 DASH-22 / DASH-23 — operator-toggleable random-MAC override.
                       D-08 placement: inside the existing "Manage" card, between Display-name
                       and the card-footer Delete button. Instant-write (no Save submit) +
                       2-second flash mirroring the Display-name `_savedFlash` pattern. *@
                    <hr class="my-3" />
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="random-mac-toggle"
                               checked="@_isRandomMac"
                               @onchange="OnRandomMacToggleChangedAsync" />
                        <label class="form-check-label fw-semibold" for="random-mac-toggle">
                            <i class="bi bi-shuffle me-2" aria-hidden="true"></i>
                            Random / privacy MAC
                        </label>
                        <small class="form-text d-block text-body-secondary">
                            This address is currently flagged as locally administered (likely random). Toggle off if it's a stable virtualized MAC like Proxmox/QEMU.
                        </small>
                        @if (_randomMacFlash) { <small class="text-success">Saved</small> }
                    </div>

                    @* v0.11 DISC-03 + DISC-04 + DISC-05 + DISC-07 (CONTEXT 14 §D-08/D-09/D-11/D-12/D-13/D-14)
                       -- Disconnect station write-side SSH action. ALWAYS visible (D-11 + D-14 single-password
                       model -- no capability gating, no role gating). Failure modes surface via _disconnectBanner. *@
                    <hr class="my-3" />

                    @if (!string.IsNullOrEmpty(_disconnectBanner))
                    {
                        <div class="alert @(_disconnectBannerIsError ? "alert-danger" : "alert-success")" role="alert">@_disconnectBanner</div>
                    }

                    <div>
                        <button type="button"
                                id="disconnect-station-button"
                                class="btn btn-outline-warning"
                                @onclick="@(() => _disconnectOpen = true)"
                                disabled="@_disconnectInFlight">
                            @if (_disconnectInFlight)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Disconnecting…</span>
                            }
                            else
                            {
                                <i class="bi bi-x-octagon me-2"></i><span>Disconnect station</span>
                            }
                        </button>
                        <small class="form-text d-block text-body-secondary mt-2">
                            Issues a ubus deauth on the access point. The station may re-associate immediately.
                        </small>
                    </div>
                </div>
                <div class="card-footer bg-body">
                    <button type="button" class="btn btn-outline-danger" @onclick="@(() => _deleteOpen = true)">
                        <i class="bi bi-trash me-2"></i>Delete this station
                    </button>
                    <a class="btn btn-link" href="/">Back to dashboard</a>
                </div>
            </div>
        </div>
    </div>

    @* Delete modal — reuses Phase 3 ConfirmationModal verbatim. CONTEXT D-14 modal copy. *@
    <ConfirmationModal IsOpen="_deleteOpen"
                       IsOpenChanged="@((bool v) => _deleteOpen = v)"
                       Title="@($"Delete station \"{(_station.Name ?? _station.MacAddress)}\"?")"
                       ConfirmLabel="Delete"
                       OnConfirm="HandleDeleteAsync">
        <Body>
            This removes it from the dashboard. If it reconnects to a monitored WLAN it will reappear on the next poll.
        </Body>
    </ConfirmationModal>

    @* v0.11 DISC-03 — disconnect confirm modal. Reuses Phase 3 ConfirmationModal verbatim. *@
    <ConfirmationModal IsOpen="_disconnectOpen"
                       IsOpenChanged="@((bool v) => _disconnectOpen = v)"
                       Title="@($"Disconnect station \"{(_station.Name ?? _station.MacAddress)}\" from this WLAN?")"
                       ConfirmLabel="Disconnect"
                       OnConfirm="HandleDisconnectAsync">
        <Body>
            Issues a ubus deauth so the station drops the association. It may re-associate immediately to a closer AP (this is the intended behaviour).
        </Body>
    </ConfirmationModal>
}

@code {
    [Parameter] public string Mac { get; set; } = string.Empty;

    private string _mac = "";
    private bool _loading = true;
    private WLANStation? _station;
    private WiFiNetwork? _network;
    private string? _apHostname;
    private string? _vendor;
    private bool _isStale;

    private NameForm _form = new();
    private bool _saving;
    private bool _savedFlash;
    private bool _deleteOpen;

    // v0.11 DISC-03 / DISC-04 / DISC-05 -- disconnect state. Kept distinct from the
    // delete/save fields so the existing tests don't observe a collision (checker Warning 9).
    private bool _disconnectOpen;
    private bool _disconnectInFlight;
    private string? _disconnectBanner;
    private bool _disconnectBannerIsError;

    // Phase 10 DASH-22 / DASH-23 — random-MAC override toggle state.
    private bool _isRandomMac;
    private bool _randomMacFlash;

    // 260516-dlu — W4 race-with-Dispose guard for the PollNotifier.Cycled subscription
    // (mirrors PollCountdown.razor:60 verbatim). Set to true FIRST in Dispose(), BEFORE
    // detaching the subscription, so a concurrent Cycled handler invocation short-circuits
    // before touching the (already torn-down) renderer.
    private volatile bool _disposed;

    private string DisplayName => _station?.Name ?? _station?.Hostname ?? _station?.MacAddress ?? "Station";

    // 260516-dlu — subscribe to PollNotifier.Cycled on the FIRST render only. OnInitializedAsync
    // runs once per component lifetime (NOT once per parameter change, which is OnParametersSetAsync).
    // Pattern: subscribe-in-Init / unsubscribe-in-Dispose with W4 double-guard (Phase 5 D-12 paired
    // adjacency; PollCountdown.razor reference).
    protected override Task OnInitializedAsync()
    {
        Notifier.Cycled += OnCycleAsync;
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        _mac = Uri.UnescapeDataString(Mac).ToUpperInvariant();   // Phase 2 D-07 MAC casing rule
        await LoadAsync();
    }

    // 260516-dlu — Cycled handler. The post-tx.CommitAsync raise from PollOrchestrator means a fresh
    // DB read will reflect any state flipped by the most recent cycle (notably stations marked
    // Offline because they were not observed in `iw dev <iface> station dump`). Re-run LoadAsync
    // to refresh _station / _network / _vendor / _isStale, then trigger a re-render. Pitfall 7:
    // the handler returns Task (NOT async void) to keep exceptions observable.
    private async Task OnCycleAsync(PollSnapshot s)
    {
        if (_disposed) return;     // W4: skip if dispose already happened
        await LoadAsync();
        // Pitfall 7 + W4 belt-and-braces: a race between this handler and Dispose() may catch
        // the renderer in a torn-down state -- swallow the ObjectDisposedException so we don't
        // crash the SignalR circuit during a navigation transition.
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // W4: race between Cycled raise and Dispose() -- renderer is gone, swallow.
        }
    }

    public void Dispose()
    {
        _disposed = true;     // W4: set BEFORE detaching subscription (paired adjacency invariant)
        Notifier.Cycled -= OnCycleAsync;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _station = await Stations.GetByMacAsync(_mac);
        if (_station is null)
        {
            _loading = false;
            return;
        }

        _form.Name = _station.Name;
        _isRandomMac = _station.IsRandomMac;
        _vendor = Oui.GetVendor(_station.MacAddress);

        if (_station.WiFiNetworkId is int netId)
        {
            _network = await Networks.GetByIdAsync(netId);
            if (_network is not null)
            {
                var allNodes = await Nodes.GetAllAsync();
                _apHostname = allNodes.FirstOrDefault(n => n.Id == _network.WiFiNodeId)?.Hostname;
            }
        }

        // Stale derivation (D-08 multiplier 2; UI-SPEC line 700, 05-UI-SPEC.md). Sense
        // is `<`: Stale = transient window within 2 cycles. The detail page's
        // _cycleEndUtc anchor is the current wall clock — Plan 03 wires Dashboard's anchor
        // to PollNotifier; the detail page is a snapshot, so "now" is the closest proxy.
        // SpecifyKind(Utc): SQLite round-trips DateTimes with Kind=Unspecified; the
        // orchestrator only ever writes UTC, so reattach the kind before the subtraction.
        _isStale = _station.Status == Status.Offline
                && (DateTime.UtcNow - DateTime.SpecifyKind(_station.LastPollDate, DateTimeKind.Utc))
                       < TimeSpan.FromSeconds(2 * Settings.PollingIntervalSeconds);

        _loading = false;
    }

    private async Task HandleSaveNameAsync()
    {
        if (_station is null) return;
        _saving = true;
        var trimmed = string.IsNullOrWhiteSpace(_form.Name) ? null : _form.Name!.Trim();
        await Stations.SetNameAsync(_station.MacAddress, trimmed);
        await LoadAsync();   // refresh DisplayName + _form.Name from DB
        _saving = false;

        // 2-second "Saved" flash — matches Phase 3 D-16 instant-write pattern.
        _savedFlash = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            _savedFlash = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>
    /// Phase 10 DASH-22 — instant-write handler for the random-MAC override toggle.
    /// No EditForm submit (a binary doesn't need form-submit semantics, D-08); each
    /// toggle change persists immediately via IStationRepo.SetIsRandomMacAsync and
    /// shows a 2-second "Saved" flash mirroring the Display-name `_savedFlash` pattern.
    /// </summary>
    private async Task OnRandomMacToggleChangedAsync(ChangeEventArgs e)
    {
        if (_station is null) return;
        var newValue = e.Value is bool b && b;
        _isRandomMac = newValue;
        await Stations.SetIsRandomMacAsync(_station.MacAddress, newValue);

        // 2-second "Saved" flash — matches the Display-name HandleSaveNameAsync pattern.
        _randomMacFlash = true;
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            _randomMacFlash = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task HandleDeleteAsync()
    {
        if (_station is null) return;
        // Quick task 260511-cmi — invalidate the in-memory MAC cache BEFORE the DB row
        // goes, so a future re-association of the same device fires the new-station
        // toast instead of being silently reclassified as already-seen.
        Events.ForgetMac(_station.MacAddress);
        await Stations.DeleteByMacAsync(_station.MacAddress);
        Nav.NavigateTo("/");
    }

    // v0.11 DISC-03/DISC-04/DISC-05/DISC-07 — Disconnect station write-side SSH action.
    // CONTEXT 14 §D-11 (always-try-and-handle-error) + §D-12 (four failure cases verbatim)
    // + §D-13 (success message + Serilog audit format) + §D-14 (single-password model:
    // no role gating).
    private async Task HandleDisconnectAsync()
    {
        if (_station is null || _network is null) return;

        var iface = _network.IfaceName;        // D-10 — IfaceName now persisted (Plan 14-04 Task 1).
        if (string.IsNullOrEmpty(iface))
        {
            // Defensive: if a fresh DB row hasn't yet been re-polled post-migration, IfaceName
            // can be null. Surface a clear error and ask the operator to wait one cycle.
            _disconnectBannerIsError = true;
            _disconnectBanner = "Disconnect failed — AP iface name not yet known. Wait one polling cycle and retry.";
            _ = AutoDismissDisconnectBanner();
            return;
        }

        var node = await Nodes.GetByIdAsync(_network.WiFiNodeId);
        if (node is null)
        {
            _disconnectBannerIsError = true;
            _disconnectBanner = "Disconnect failed — AP not found.";
            _ = AutoDismissDisconnectBanner();
            return;
        }

        _disconnectInFlight = true;
        _disconnectBanner = null;
        try
        {
            var result = await NodeAdmin.DisconnectStationAsync(node, _station.MacAddress, iface, CancellationToken.None);
            switch (result)
            {
                case ApStatsForOpenWrt.Services.Admin.DisconnectResult.Success:
                    _disconnectBannerIsError = false;
                    _disconnectBanner = "Disconnect issued — station should leave the WLAN on the next poll cycle.";
                    Log.LogInformation(
                        "Disconnect issued: NodeId={NodeId} Iface={Iface} StationMac={Mac}",
                        node.Id, iface, _station.MacAddress);
                    // 260516-dlu — optimistic UI update: flip the local Status to Offline immediately
                    // so the StatusBadge reflects the operator's intent without waiting for the next
                    // poll cycle. The Cycled subscription wired in OnInitializedAsync converges
                    // authoritatively on the next ≤ PollingIntervalSeconds tick -- either confirms
                    // Offline (station no longer associated) or corrects to Online (station re-
                    // associated within the cycle window). Bounded optimism is acceptable here:
                    // the operator's mental model after clicking Disconnect is "the station IS now
                    // disconnected" and the badge should match that intent immediately.
                    _station.Status = Status.Offline;
                    break;
                case ApStatsForOpenWrt.Services.Admin.DisconnectResult.Timeout:
                    _disconnectBannerIsError = true;
                    _disconnectBanner = "Disconnect failed — AP unreachable within 5s.";
                    Log.LogWarning(
                        "Disconnect failed (timeout): NodeId={NodeId} Iface={Iface} StationMac={Mac}",
                        node.Id, iface, _station.MacAddress);
                    break;
                case ApStatsForOpenWrt.Services.Admin.DisconnectResult.NotSupported ns:
                    _disconnectBannerIsError = true;
                    _disconnectBanner = "Disconnect not supported on this AP — ubus/hostapd missing.";
                    Log.LogWarning(
                        "Disconnect failed (not-supported): NodeId={NodeId} Iface={Iface} StationMac={Mac} Raw={Raw}",
                        node.Id, iface, _station.MacAddress, ns.Raw);
                    break;
                case ApStatsForOpenWrt.Services.Admin.DisconnectResult.NoSuchStation nss:
                    _disconnectBannerIsError = false;       // D-12 case 3 — informational tone.
                    _disconnectBanner = "Station is no longer associated with this AP.";
                    Log.LogInformation(
                        "Disconnect: station already absent: NodeId={NodeId} Iface={Iface} StationMac={Mac} Raw={Raw}",
                        node.Id, iface, _station.MacAddress, nss.Raw);
                    break;
                case ApStatsForOpenWrt.Services.Admin.DisconnectResult.UnknownError ue:
                    _disconnectBannerIsError = true;
                    _disconnectBanner = "Disconnect failed — check logs.";
                    Log.LogWarning(
                        "Disconnect failed (unknown): NodeId={NodeId} Iface={Iface} StationMac={Mac} Raw={Raw}",
                        node.Id, iface, _station.MacAddress, ue.Raw);
                    break;
            }
        }
        finally
        {
            _disconnectInFlight = false;
            _ = AutoDismissDisconnectBanner();
        }
    }

    private async Task AutoDismissDisconnectBanner()
    {
        // Mirrors Settings.razor:296-301 5-second auto-dismiss pattern (operator legibility).
        await Task.Delay(5000);
        _disconnectBanner = null;
        await InvokeAsync(StateHasChanged);
    }

    private static string RelativeTime(DateTime t)
    {
        if (t == default) return "Never";
        // SQLite has no native DateTime type — EF Core round-trips DateTimes back with
        // Kind=Unspecified. The orchestrator only ever writes DateTime.UtcNow, so treat
        // an Unspecified value as UTC; ToUniversalTime() would otherwise interpret it
        // as local and subtract the local offset (off-by-N hours bug).
        var d = DateTime.UtcNow - DateTime.SpecifyKind(t, DateTimeKind.Utc);
        if (d.TotalSeconds < 60) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    // Bitrate display uses invariant culture so the decimal separator is always '.' —
    // matches the UI-SPEC §Copywriting Contract format ("{n} Mb/s") regardless of the
    // operator's browser locale (e.g. it-IT renders 144,4 by default which would diverge
    // from the locked copy).
    private static string FormatBitrate(double mbps) =>
        string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0} Mb/s", mbps);

    private sealed class NameForm
    {
        [MaxLength(64, ErrorMessage = "Display name must be 64 characters or fewer.")]
        public string? Name { get; set; }
    }
}
