@page "/Settings"
@* Settings/Index.razor — D-17 three-card structure (Polling interval / UI password /
   SSH known-hosts cache) per UI-SPEC §Settings (lines 397-436). All operator-facing copy
   is verbatim from UI-SPEC §Settings + §Confirmation Modal lines 502-509.

   Plan 03-05: SET-01 (interval radio), SET-02 (password set/clear), SET-03 (bulk known-hosts
   clear), SET-04 (no-restart propagation via IAppSettingsService.Changed event chain).
   Plan 14-02: ENRICH-02 Run-now button on Active enrichment card; D-06 OR-condition
   disable-state subscribed to PollNotifier.CycleStarted / Cycled. *@
@using ApStatsForOpenWrt.Services.Auth
@using ApStatsForOpenWrt.Services.Enrichment
@using ApStatsForOpenWrt.Services.Polling
@using ApStatsForOpenWrt.Services.Settings
@using ApStatsForOpenWrt.Services.UpdateCheck

@inject IAppSettingsService Settings
@inject IUIPasswordHasher Hasher
@* v0.11 ENRICH-02 / CONTEXT 14 §D-05/D-06 — Run-now button injects the force-flag service
   + PollNotifier (cycle-in-flight half of the D-06 OR-condition). *@
@inject IForceEnrichmentService ForceEnrichment
@inject PollNotifier Notifier
@* Phase 17 M-UPD-05 — the Update-check card injects the checker seam (Check now button) +
   the UpdateNotifier (reload-free diagnostic refresh after a successful check). *@
@inject IUpdateChecker Checker
@inject UpdateNotifier UpdateNotifier
@* Phase 8 Plan 08-07 REQ-UI-44 — the new UI preferences card consumes PreferencesService
   ONLY. NEVER IAppSettingsService — per-browser preference, not a DB setting. *@
@inject ApStatsForOpenWrt.Services.PreferencesService Prefs
@implements IDisposable

<PageHeader Title="Settings" />

@* ==== Card 1: Live polling interval (SET-01 / SET-04 propagation; D-05 rename) ==== *@
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">Live polling interval</h5></div>
    <div class="card-body">
        <small class="text-body-secondary d-block mb-3">How often each AP is polled for connected stations.</small>

        @if (!string.IsNullOrEmpty(_intervalBanner))
        {
            <div class="alert alert-success" role="alert">@_intervalBanner</div>
        }

        <EditForm Model="_intervalForm" OnValidSubmit="HandleSaveIntervalAsync" FormName="interval-form">
            <DataAnnotationsValidator />
            <InputRadioGroup @bind-Value="_intervalForm.Seconds" Name="interval-seconds">
                @foreach (var seconds in new[] { 5, 10, 30 })
                {
                    <div class="form-check">
                        <InputRadio class="form-check-input" id="@($"interval-{seconds}")" Value="@seconds" />
                        <label class="form-check-label" for="@($"interval-{seconds}")">@seconds seconds</label>
                    </div>
                }
            </InputRadioGroup>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </EditForm>
    </div>
</div>

@* ==== Active enrichment interval (Phase 10 SET-01 / D-03 / D-05) + v0.11 ENRICH-02 Run now ==== *@
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">Active enrichment interval</h5></div>
    <div class="card-body">
        <small class="text-body-secondary d-block mb-3">How often IP addresses and hostnames are refreshed via active probing. Only runs when the live polling cycle detects a new client or when this interval expires.</small>

        @if (!string.IsNullOrEmpty(_refreshBanner))
        {
            <div class="alert alert-success" role="alert">@_refreshBanner</div>
        }
        @if (!string.IsNullOrEmpty(_runNowBanner))
        {
            <div class="alert alert-success" role="alert">@_runNowBanner</div>
        }

        <EditForm Model="_refreshForm" OnValidSubmit="HandleSaveRefreshAsync" FormName="refresh-form">
            <DataAnnotationsValidator />
            <InputRadioGroup @bind-Value="_refreshForm.Seconds" Name="refresh-seconds">
                @foreach (var (seconds, label) in RefreshPresets)
                {
                    <div class="form-check">
                        <InputRadio class="form-check-input" id="@($"refresh-{seconds}")" Value="@seconds" />
                        <label class="form-check-label" for="@($"refresh-{seconds}")">@label</label>
                    </div>
                }
            </InputRadioGroup>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </EditForm>

        @* v0.11 ENRICH-02 (CONTEXT 14 §D-05/D-06/D-07) — "Run now" button + OR-condition disable-state. *@
        <hr class="my-3" />
        <div class="d-flex align-items-center">
            <button type="button"
                    id="run-now-button"
                    class="btn btn-outline-primary"
                    @onclick="HandleRunNowAsync"
                    disabled="@(_cycleInFlight || ForceEnrichment.IsQueued)">
                @if (_cycleInFlight || ForceEnrichment.IsQueued)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Queued…</span>
                }
                else
                {
                    <span>Run now</span>
                }
            </button>
            <small class="text-body-secondary ms-3">Forces an immediate enrichment pass on the next polling cycle.</small>
        </div>
    </div>
</div>

@* ==== NEW: Local domain suffixes (Phase 10 SET-02 / D-04) ==== *@
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">Local domain suffixes</h5></div>
    <div class="card-body">
        <small class="text-body-secondary d-block mb-3">Comma-separated list of local domain suffixes (e.g., <code>localnetwork, lab.local</code>). Stripped from station hostnames at display time. Leave blank to show full FQDNs.</small>

        @if (!string.IsNullOrEmpty(_suffixesBanner))
        {
            <div class="alert alert-success" role="alert">@_suffixesBanner</div>
        }
        @if (!string.IsNullOrEmpty(_suffixesError))
        {
            <div class="alert alert-danger" role="alert">@_suffixesError</div>
        }

        <EditForm Model="_suffixesForm" OnValidSubmit="HandleSaveSuffixesAsync" FormName="suffixes-form">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label" for="suffixes-input">Suffixes</label>
                <InputText id="suffixes-input" class="form-control" @bind-Value="_suffixesForm.CommaSeparated" placeholder="localnetwork, lab.local" />
            </div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </EditForm>
    </div>
</div>

@* ==== Card 2: UI password (SET-02 / SEC-04) ==== *@
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">UI password</h5></div>
    <div class="card-body">
        @if (string.IsNullOrEmpty(Settings.UIPasswordHash))
        {
            <small class="text-body-secondary d-block mb-3">
                No password is set. Anyone reaching the dashboard can see and change everything.
                Set a password to require sign-in.
            </small>
        }
        else
        {
            <small class="text-body-secondary d-block mb-3">
                Sign-in is required. Set a new password below or clear it to disable sign-in.
            </small>
        }

        @if (!string.IsNullOrEmpty(_passwordBanner))
        {
            <div class="alert alert-success" role="alert">@_passwordBanner</div>
        }
        @if (!string.IsNullOrEmpty(_passwordError))
        {
            <div class="alert alert-danger" role="alert">@_passwordError</div>
        }

        <EditForm Model="_passwordForm" OnValidSubmit="HandleSetPasswordAsync" FormName="password-form">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold" for="new-password">New password</label>
                <InputText id="new-password" type="password" class="form-control" @bind-Value="_passwordForm.NewPassword" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="confirm-password">Confirm password</label>
                <InputText id="confirm-password" type="password" class="form-control" @bind-Value="_passwordForm.ConfirmPassword" />
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">Set password</button>
                @if (!string.IsNullOrEmpty(Settings.UIPasswordHash))
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="@(() => _clearPwdModal = true)">Clear password</button>
                }
            </div>
        </EditForm>
    </div>
</div>

@* ==== Card 4: UI preferences (Phase 8 Plan 08-07 REQ-UI-44) ====
   This card uses PreferencesService ONLY — NEVER IAppSettingsService.
   Per-browser preference (localStorage); CLAUDE.md "DB writes orchestrator-only"
   invariant is preserved because this card never touches the AppSetting table. *@
<div class="card mb-4">
    <div class="card-header py-2 px-3">
        <h5 class="card-title mb-0">UI preferences</h5>
        <small class="text-body-secondary">
            Browser-only preferences. Saved to this browser's localStorage; not stored in the database.
        </small>
    </div>
    <div class="card-body">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="notifications-toggle"
                   checked="@_notificationsEnabled"
                   @onchange="OnNotificationsToggleChangedAsync" />
            <label class="form-check-label" for="notifications-toggle">
                <i class="bi @(_notificationsEnabled ? "bi-bell-fill" : "bi-bell-slash-fill") me-2" aria-hidden="true"></i>
                Enable toast notifications
            </label>
            <small class="form-text d-block text-body-secondary">
                When off, toasts for new stations and AP status changes are suppressed in this browser.
            </small>
        </div>
    </div>
</div>

@* ==== Card 6: Update check (Phase 17 M-UPD-05 / D-03) ====
   Toggle (immediate DB persist via IAppSettingsService — NOT PreferencesService; this is a
   DB setting per CONTEXT.md) + read-only diagnostics (greyed when OFF, D-03) + "Check now"
   (disabled while in-flight AND when the toggle is OFF, D-03; re-enables on success/failure).
   The diagnostic block refreshes without a page reload via the UpdateNotifier/Settings.Changed
   subscriptions wired in OnInitializedAsync. *@
<div class="card mb-4">
    <div class="card-header"><h5 class="card-title mb-0">Update check</h5></div>
    <div class="card-body">
        <small class="text-body-secondary d-block mb-3">Periodically checks GitHub for a newer release and surfaces a calm badge + one-time notification when one is available. Turn off for zero outbound traffic.</small>

        @if (!string.IsNullOrEmpty(_updateCheckBanner))
        {
            <div class="alert alert-success" role="alert">@_updateCheckBanner</div>
        }

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch"
                   id="update-check-toggle"
                   checked="@Settings.UpdateCheckEnabled"
                   @onchange="OnUpdateCheckToggleChangedAsync" />
            <label class="form-check-label" for="update-check-toggle">
                <i class="bi @(Settings.UpdateCheckEnabled ? "bi-arrow-repeat" : "bi-pause-circle") me-2" aria-hidden="true"></i>
                Enable automatic update checks
            </label>
        </div>

        @* D-03 — diagnostics greyed/muted when the toggle is OFF. *@
        <dl class="row mb-3 @(Settings.UpdateCheckEnabled ? string.Empty : "text-body-secondary opacity-50")" id="update-check-diagnostics">
            <dt class="col-sm-4">Current version</dt>
            <dd class="col-sm-8">@CurrentVersionString</dd>

            <dt class="col-sm-4">Latest known</dt>
            <dd class="col-sm-8">@(string.IsNullOrEmpty(Settings.LatestKnownVersion) ? "—" : Settings.LatestKnownVersion)</dd>

            <dt class="col-sm-4">Last checked</dt>
            <dd class="col-sm-8">@(Settings.LastCheckedAtUtc is null ? "never" : RelativeTime(Settings.LastCheckedAtUtc.Value))</dd>
        </dl>

        <div class="d-flex align-items-center">
            <button type="button"
                    id="check-now-button"
                    class="btn btn-outline-primary"
                    @onclick="HandleCheckNowAsync"
                    disabled="@(_checkInFlight || !Settings.UpdateCheckEnabled)">
                @if (_checkInFlight)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Checking…</span>
                }
                else
                {
                    <span>Check now</span>
                }
            </button>
            <small class="text-body-secondary ms-3">Runs an update check immediately instead of waiting for the daily cycle.</small>
        </div>
    </div>
</div>

@* ==== Modals ==== *@
<ConfirmationModal IsOpen="_clearPwdModal"
                   IsOpenChanged="@((bool v) => { _clearPwdModal = v; })"
                   Title="Clear the UI password?"
                   ConfirmLabel="Clear password and disable sign-in"
                   OnConfirm="HandleClearPasswordAsync">
    <Body>
        Sign-in will no longer be required. Anyone who can reach the dashboard will be able to view
        and change everything.
    </Body>
</ConfirmationModal>

@code {
    private IntervalForm _intervalForm = new();
    private RefreshForm _refreshForm = new();
    private SuffixesForm _suffixesForm = new();
    private PasswordForm _passwordForm = new();
    private bool _clearPwdModal;

    private string? _intervalBanner;
    private string? _refreshBanner;
    private string? _suffixesBanner;
    private string? _suffixesError;
    private string? _passwordBanner;
    private string? _passwordError;

    // ── v0.11 ENRICH-02 (CONTEXT 14 §D-05/D-06) — Run-now button state ────────
    private string? _runNowBanner;
    // tracks CycleStarted received without subsequent Cycled; volatile because the
    // PollNotifier event handlers run on a different thread than the Blazor render context.
    private volatile bool _cycleInFlight;

    // D-03 verbatim — five preset values for the Active enrichment interval radio group.
    // Stored as int seconds to match AppSetting.RefreshIntervalSeconds.IntValue persistence.
    private static readonly IReadOnlyList<(int Seconds, string Label)> RefreshPresets = new[]
    {
        (900,   "15 minutes"),
        (1800,  "30 minutes"),
        (3600,  "1 hour"),
        (21600, "6 hours"),
        (86400, "24 hours"),
    };

    // D-04 — single inline rule per token: ASCII letters/digits/dots/hyphens only.
    // Per-token validator runs BEFORE persistence; invalid input is rejected with a banner
    // and no AppSetting write is attempted (T-10-02-01 trust-boundary mitigation).
    private static readonly System.Text.RegularExpressions.Regex SuffixTokenRegex =
        new(@"^[A-Za-z0-9.\-]+$", System.Text.RegularExpressions.RegexOptions.Compiled);

    protected override async Task OnInitializedAsync()
    {
        // v0.11 ENRICH-02 / CONTEXT 14 §D-06 — subscribe BEFORE the await so a Cycled
        // event firing during WarmAsync still reaches the handler (Phase 5 D-12 pattern).
        Notifier.CycleStarted += OnCycleStartedAsync;
        Notifier.Cycled       += OnCycledAsync;

        // Phase 17 M-UPD-05 — subscribe BEFORE the await (same paired-adjacency discipline) so a
        // check completing during WarmAsync still re-renders the diagnostic block without a reload.
        // UpdateAvailable fires on a real N→N+1 advance; Settings.Changed fires after every setter
        // (incl. the timestamp-only write on an up-to-date check), covering "Last checked" refresh.
        UpdateNotifier.UpdateAvailable += OnUpdateAvailableAsync;
        Settings.Changed += OnSettingsChanged;

        // Defensive — Settings should already be warm via AppSettingsBootstrapHostedService;
        // re-warm idempotently to handle edge cases like a fresh in-memory test DB.
        await Settings.WarmAsync();
        _intervalForm.Seconds = Settings.PollingIntervalSeconds;
        _refreshForm.Seconds = Settings.RefreshIntervalSeconds;
        _suffixesForm.CommaSeparated = string.Join(", ", Settings.LocalDomainSuffixes);
    }

    // ── v0.11 ENRICH-02 (CONTEXT 14 §D-05/D-06) — Run-now handlers + disposal ──
    private Task OnCycleStartedAsync()
    {
        _cycleInFlight = true;
        return InvokeAsync(StateHasChanged);   // re-render to flip disabled state to true
    }

    private Task OnCycledAsync(PollSnapshot _)
    {
        _cycleInFlight = false;
        return InvokeAsync(StateHasChanged);   // re-render to flip disabled state back to false
    }

    private Task HandleRunNowAsync()
    {
        ForceEnrichment.Request();
        _runNowBanner = "Enrichment queued — will run on the next polling cycle.";
        _ = AutoDismissAsync(() => _runNowBanner = null);
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Notifier.CycleStarted -= OnCycleStartedAsync;
        Notifier.Cycled       -= OnCycledAsync;
        // Phase 17 M-UPD-05 — symmetric unsubscribe (Pattern 2).
        UpdateNotifier.UpdateAvailable -= OnUpdateAvailableAsync;
        Settings.Changed -= OnSettingsChanged;
    }

    // ── Card 6 (Phase 17 M-UPD-05) — Update-check state + handlers ──────────
    private bool _checkInFlight;
    private string? _updateCheckBanner;

    // Mirrors the MainLayout footer idiom (typeof(...).Assembly.GetName().Version). The Settings
    // "Current version" line shows the running assembly version (3-part); NO literal version
    // string (260518-vbs).
    private static readonly string CurrentVersionString =
        typeof(Index).Assembly.GetName().Version?.ToString(3) ?? "unknown";

    private async Task OnUpdateCheckToggleChangedAsync(ChangeEventArgs e)
    {
        var newValue = e.Value is bool b && b;
        // Immediate DB persist (NOT PreferencesService) — Settings.Changed then propagates to the
        // navbar badge. Mirrors the immediate-persist toggle pattern, NOT the EditForm/Save pattern.
        await Settings.SetUpdateCheckEnabledAsync(newValue);
    }

    private async Task HandleCheckNowAsync()
    {
        _checkInFlight = true;
        try
        {
            // Single shared code path with the 24h hosted loop. CheckOnceAsync never throws in
            // production (it wraps the whole fetch+parse in one try/catch), but we still CATCH here
            // (defense-in-depth, Rule 2): a thrown failure escaping a Blazor event handler tears
            // down the circuit. Catching keeps the page alive and the finally re-enables the button
            // on BOTH success and a thrown failure (M-UPD-05 — recover regardless of outcome).
            await Checker.CheckOnceAsync();
            _updateCheckBanner = "Update check complete.";
            _ = AutoDismissAsync(() => _updateCheckBanner = null);
        }
        catch
        {
            // Swallow — the button must re-enable and the page must survive. The checker already
            // logs its own failures (Plan 02); there is no operator-actionable detail to surface.
        }
        finally
        {
            _checkInFlight = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task OnUpdateAvailableAsync(UpdateInfo _) => InvokeAsync(StateHasChanged);

    private void OnSettingsChanged(IAppSettingsService settings) => _ = InvokeAsync(StateHasChanged);

    // Replicated from Dashboard.razor:684-696. SpecifyKind(Utc) is mandatory — the AppSetting
    // round-trip returns Kind=Unspecified; ToUniversalTime() would subtract the local offset.
    private static string RelativeTime(DateTime t)
    {
        if (t == default) return "never";
        var d = DateTime.UtcNow - DateTime.SpecifyKind(t, DateTimeKind.Utc);
        if (d.TotalSeconds < 60) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24)   return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    // ── Card 4 (Phase 8 Plan 08-07 REQ-UI-44) — UI preferences state ────────
    private bool _notificationsEnabled = true;
    private bool _restored;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // CLAUDE.md prerender rule + PITFALLS.md Pitfall 7: localStorage interop is
        // ONLY safe in OnAfterRenderAsync(firstRender:true). Internal _restored gate
        // prevents re-restore on subsequent renders. Explicit StateHasChanged after
        // the read so the toggle reflects the persisted value.
        if (!firstRender || _restored) return;
        _notificationsEnabled = await Prefs.IsNotificationsEnabledAsync();
        _restored = true;
        StateHasChanged();
    }

    private async Task OnNotificationsToggleChangedAsync(ChangeEventArgs e)
    {
        var newValue = e.Value is bool b && b;
        _notificationsEnabled = newValue;
        await Prefs.SetNotificationsEnabledAsync(newValue);
    }

    // ── Card 1 handlers ─────────────────────────────────────────────────────
    private async Task HandleSaveIntervalAsync()
    {
        await Settings.SetPollingIntervalSecondsAsync(_intervalForm.Seconds);
        _intervalBanner = "Polling interval saved. The next cycle will use the new interval.";
        _ = AutoDismissAsync(() => _intervalBanner = null);
    }

    // ── Active enrichment interval handler (Phase 10 SET-01 / D-03) ─────────
    private async Task HandleSaveRefreshAsync()
    {
        await Settings.SetRefreshIntervalSecondsAsync(_refreshForm.Seconds);
        _refreshBanner = "Active enrichment interval saved. The next refresh tick will use the new interval.";
        _ = AutoDismissAsync(() => _refreshBanner = null);
    }

    // ── Local domain suffixes handler (Phase 10 SET-02 / D-04) ──────────────
    private async Task HandleSaveSuffixesAsync()
    {
        _suffixesBanner = null;
        _suffixesError = null;

        var raw = _suffixesForm.CommaSeparated ?? string.Empty;
        var tokens = raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        // Per-token validation runs BEFORE the write — D-04 verbatim ("Invalid token →
        // banner + save rejected (no partial persist)"). T-10-02-01 trust-boundary defense.
        foreach (var t in tokens)
        {
            if (t.StartsWith('.'))
            {
                _suffixesError = $"Invalid suffix \"{t}\" — suffixes must not start with a dot.";
                return;
            }
            if (!SuffixTokenRegex.IsMatch(t))
            {
                _suffixesError = $"Invalid suffix \"{t}\" — suffixes must contain only ASCII letters, digits, dots, and hyphens (no spaces, no leading dot).";
                return;
            }
        }

        await Settings.SetLocalDomainSuffixesAsync(tokens);
        // Reflect cleaned form back to the operator (collapse extra spaces/empties).
        _suffixesForm.CommaSeparated = string.Join(", ", tokens);
        _suffixesBanner = "Local domain suffixes saved. The dashboard will use the new list on the next render.";
        _ = AutoDismissAsync(() => _suffixesBanner = null);
    }

    // ── Card 2 handlers ─────────────────────────────────────────────────────
    private async Task HandleSetPasswordAsync()
    {
        _passwordBanner = null;
        _passwordError = null;

        if (string.IsNullOrEmpty(_passwordForm.NewPassword))
        {
            _passwordError = "Enter a password.";
            return;
        }
        if (_passwordForm.NewPassword != _passwordForm.ConfirmPassword)
        {
            _passwordError = "Passwords do not match.";
            return;
        }

        var wasSet = !string.IsNullOrEmpty(Settings.UIPasswordHash);

        // M-SEC-03 / plan 15-05 — UIPasswordHasher.Hash (plan 15-02) throws ArgumentException
        // with the verbatim operator-facing policy message when the plaintext fails the
        // four-part policy (>=8 chars + upper + lower + digit-or-symbol). Surface ex.Message
        // verbatim via the existing _passwordError -> alert-danger rendering path (above
        // the alert-success _passwordBanner in the password card template). No DB write,
        // no session bump, no banner-success — operator sees the verbatim policy reason
        // and the form is preserved for retry.
        string hash;
        try
        {
            hash = Hasher.Hash(_passwordForm.NewPassword);
        }
        catch (ArgumentException ex)
        {
            _passwordError = ex.Message;
            return;
        }
        await Settings.SetUIPasswordHashAsync(hash);

        // M-SEC-04 / plan 15-04 — banner copy update. After Plan 15-04, every existing session
        // is invalidated by the SessionVersion bump (atomic inside SetUIPasswordHashAsync).
        // The verbatim phrase "All sessions have been signed out." is pinned by REQUIREMENTS.md
        // line 38 + the integration tests in plan 15-04 (substring assertion).
        _passwordBanner = wasSet
            ? "Password updated. All sessions have been signed out."
            : "Password set. Sign-in is now required for all pages except the login screen.";
        _passwordForm = new PasswordForm();   // wipe form
        _ = AutoDismissAsync(() => _passwordBanner = null);
    }

    private async Task HandleClearPasswordAsync()
    {
        await Settings.SetUIPasswordHashAsync(null);
        // M-SEC-04 / plan 15-04 — clearing the password ALSO bumps SessionVersion (15-01
        // symmetric mitigation), so every existing session is invalidated. The pinned phrase
        // "All sessions have been signed out." appears verbatim as a substring.
        _passwordBanner = "Password cleared. All sessions have been signed out. Sign-in is no longer required.";
        _ = AutoDismissAsync(() => _passwordBanner = null);
    }

    private async Task AutoDismissAsync(Action clearAction)
    {
        await Task.Delay(5000);
        clearAction();
        await InvokeAsync(StateHasChanged);
    }

    public sealed class IntervalForm
    {
        public int Seconds { get; set; } = 30;   // matches AppSettingsService default
    }

    public sealed class RefreshForm
    {
        // D-03 default — 1h (3600s). Also matches Phase 9 SCHEMA-06 seed for RefreshIntervalSeconds.
        public int Seconds { get; set; } = 3600;
    }

    public sealed class SuffixesForm
    {
        public string? CommaSeparated { get; set; }
    }

    public sealed class PasswordForm
    {
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}
