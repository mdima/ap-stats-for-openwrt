@page "/Login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@* Pitfall 2: opt out of D-06 global InteractiveServer — sign-in needs static SSR roundtrip.

   M-SEC-03 brute-force limiting is POST-ONLY (debug login-429-counts-page-views,
   operator-approved 2026-05-30) and is enforced ENTIRELY in Program.cs via opts.GlobalLimiter
   (chained per-IP 5/min + global 30/min partitions, both gated on Method == "POST" &&
   Path == /Login). There is deliberately NO [EnableRateLimiting] attribute on this page: an
   EnableRateLimiting attribute on a Razor page endpoint cannot be method-scoped, so it counted
   GET page views (the sign-out → /Login redirect chain, reloads) against the per-IP budget and
   429'd legitimate operators on the 6th view. Removing it makes GET /Login free while POST
   attempts stay capped at the unchanged M-SEC-03 numbers. *@
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Identity
@using ApStatsForOpenWrt.Services.Auth
@using ApStatsForOpenWrt.Services.Settings

@inject IAppSettingsService Settings
@inject IUIPasswordHasher Hasher
@inject NavigationManager Nav

<PageTitle>AP Stats for OpenWrt — Sign in</PageTitle>

<h1 class="h4 fw-semibold text-center mb-1">Sign in</h1>
<p class="login-box-msg text-body-secondary text-center">Sign in to manage your access points</p>

@if (!string.IsNullOrEmpty(_banner))
{
    <div class="alert alert-danger" role="alert">@_banner</div>
}

@* No explicit <AntiforgeryToken /> here — <EditForm method="post"> auto-injects exactly
   one __RequestVerificationToken hidden input. Adding a second one (e.g. via a literal
   <AntiforgeryToken />) caused Phase 7 LIVE-UAT row 3.3 to fail with "A valid antiforgery
   token was not provided": the browser submitted both tokens, Request.Form coalesced them
   into a comma-separated StringValues, and the validator could not match the cookie token. *@
<EditForm Model="form" method="post" OnValidSubmit="HandleLoginAsync" FormName="login">
    <DataAnnotationsValidator />

    @* Auth model is single shared UI password (SEC-04: PBKDF2 hash) — no per-user identity.
       The setup wizard (Phase 4) collects only a password; the cookie principal's display name
       is always the literal "operator". Surfacing a Username field on /Login was a UX nicety
       from the Phase 3 UI-SPEC that confused operators during Phase 7 LIVE-UAT row 3.3 — they
       had nothing meaningful to type. Dropped here for consistency with the auth model. *@
    <div class="input-group mb-3">
        <InputText type="password" class="form-control" placeholder="Password" autocomplete="current-password"
                   @bind-Value="form.Password" />
        <div class="input-group-text"><i class="bi bi-lock-fill"></i></div>
    </div>
    <ValidationMessage For="@(() => form.Password)" class="invalid-feedback d-block" />

    <div class="row mt-3">
        <div class="col-12">
            <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_returnUrlHint))
{
    <div class="mt-3">
        <small class="text-body-secondary">You'll return to @_returnUrlHint after signing in.</small>
    </div>
}

@code {
    // Non-nullable + no initializer — Blazor BL0008 requires [SupplyParameterFromForm] to
    // not have a property initializer (post may overwrite with null). We initialize lazily
    // in OnInitialized via the null-coalescing assignment, which is the canonical pattern.
    [SupplyParameterFromForm] private LoginForm form { get; set; } = default!;
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string? _banner;
    private string? _returnUrlHint;

    public sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string? Password { get; set; }
    }

    protected override void OnInitialized()
    {
        // Initialize the form model lazily (BL0008 prohibits initializer on the property).
        form ??= new LoginForm();

        // ReturnUrl visual hint — UI-SPEC §Login page (lines 286-287).
        var returnUrl = HttpContext?.Request.Query["returnUrl"].ToString();
        if (!string.IsNullOrEmpty(returnUrl) && returnUrl != "/")
        {
            _returnUrlHint = returnUrl.TrimStart('/').Replace("/", " › ");
        }
    }

    private async Task HandleLoginAsync()
    {
        // D-01: if the gate is disabled (UIPasswordHash null/empty) we should not be here.
        // Defensive: redirect to /.
        var hash = Settings.UIPasswordHash;
        if (string.IsNullOrEmpty(hash))
        {
            Nav.NavigateTo("/", forceLoad: true);   // forceLoad MANDATORY (Pitfall 2)
            return;
        }

        var verifyResult = Hasher.Verify(hash, form.Password ?? "");
        if (verifyResult == PasswordVerificationResult.Failed)
        {
            _banner = "Sign-in failed. Check your password and try again.";
            return;
        }

        // Pitfall 8 — re-hash if framework signaled an upgrade is available.
        if (verifyResult == PasswordVerificationResult.SuccessRehashNeeded)
        {
            try
            {
                var newHash = Hasher.Hash(form.Password ?? "");
                await Settings.SetUIPasswordHashAsync(newHash, HttpContext.RequestAborted);
            }
            catch (ArgumentException ex)
            {
                // M-SEC-03 / plan 15-05 — operator's existing password (just verified by
                // Hasher.Verify above) does NOT satisfy the new four-part policy. Don't
                // sign them in; surface the verbatim policy message and keep the legacy
                // hash in place (no SetUIPasswordHashAsync write happens in the catch path).
                // They can still authenticate later — they just don't get rehashed mid-sign-in
                // if their current password is below policy. The pinned operator-facing copy
                // lives in UIPasswordHasher.PolicyMessage (plan 15-02); ex.Message surfaces
                // it 1:1 (the framework appends " (Parameter '...)" but the prefix is the
                // operator-facing literal). PasswordPolicyBannerTests pins this end-to-end.
                _banner = ex.Message;
                return;
            }
        }

        // Single shared UI password — no per-user identity. The cookie principal's Name claim
        // is hardcoded to "operator" to match MainLayout's user-menu display label.
        //
        // M-SEC-04 / plan 15-04 — stamp the current SessionVersion as a claim so a future
        // password-change (which bumps SessionVersion via 15-01) invalidates this cookie on
        // the next request via Program.cs's OnValidatePrincipal event. Claim store is
        // string-typed; OnValidatePrincipal parses back via int.TryParse.
        var claims = new[]
        {
            new Claim(ClaimTypes.Name, "operator"),
            new Claim("session_version", Settings.SessionVersion.ToString(System.Globalization.CultureInfo.InvariantCulture)),
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            new ClaimsPrincipal(identity));

        // Pitfall 2 — forceLoad MANDATORY so the antiforgery token is rebound to the new identity.
        var returnUrl = HttpContext.Request.Query["returnUrl"].ToString();
        Nav.NavigateTo(string.IsNullOrEmpty(returnUrl) ? "/" : returnUrl, forceLoad: true);
    }
}
