@page "/Nodes/{Id:int}"
@implements IDisposable
@using ApStatsForOpenWrt.Services.Nodes
@using ApStatsForOpenWrt.Services.Polling

@inject INodeRepo Nodes
@inject INetworkRepo Networks
@inject IWlanDiscoveryService Discovery
@inject NavigationManager Nav
@* 260517-ndr — live-update subscription so the page reflects DB-side changes
   (notably node Online/Offline transitions and refreshed LastPollDate) without
   manual navigation/F5. Mirrors the 260516-dlu pattern that was applied to
   Stations/Detail.razor; closes the parallel gap on the Nodes detail page. *@
@inject PollNotifier Notifier

@* /Nodes/{id} — NODE-05 (status + last polled) + WLAN-01..04 + per-node SET-03
   Re-trust UI. UI-SPEC §Node Detail lines 378-395.

   v0.11 / Quick task 260517-ndr: the page subscribes to PollNotifier.Cycled in
   OnInitializedAsync and re-runs LoadAsync on every successful cycle, then
   unsubscribes in Dispose with W4 double-guard (volatile _disposed flag +
   try/catch around InvokeAsync) mirroring PollCountdown.razor's disposal
   discipline and 260516-dlu's Stations/Detail.razor wire-up verbatim. *@

@if (_node is null)
{
    <p class="text-body-secondary">Loading…</p>
}
else
{
    <PageHeader Title="@_node.Hostname" />

    @* Card 1: Connection summary + Re-trust button *@
    <div class="card mb-3">
        <div class="card-header"><h5 class="card-title mb-0">Connection</h5></div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Hostname</dt>
                <dd class="col-sm-9"><code class="font-monospace">@_node.Hostname</code></dd>
                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@_node.Username</dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><StatusBadge Status="_node.Status" /></dd>
                <dt class="col-sm-3">Last polled</dt>
                <dd class="col-sm-9">@RelativeTime(_node.LastPollDate)</dd>
                <dt class="col-sm-3">Host key</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrEmpty(_node.HostKeyFingerprint))
                    {
                        <span class="text-body-secondary">Not yet trusted</span>
                    }
                    else
                    {
                        <code class="font-monospace">@(_node.HostKeyFingerprint.Length > 16 ? _node.HostKeyFingerprint[..16] + "…" : _node.HostKeyFingerprint)</code>
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => _retrustOpen = true)">
                <i class="bi bi-shield-check me-2"></i>Re-trust this AP
            </button>
            <a class="btn btn-link" href="/Nodes">Back to nodes</a>
        </div>
    </div>

    @* Card 2: WLANs *@
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h5 class="card-title mb-0">WLANs</h5>
                <small class="text-body-secondary">Toggle Enabled to control which WLANs are polled.</small>
            </div>
            <button type="button" class="btn btn-primary" @onclick="HandleDiscoverAsync" disabled="@_discovering">
                @if (_discovering)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Discovering…</span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-2"></i>
                    <span>Discover WLANs</span>
                }
            </button>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(_discoverBanner))
            {
                <div class="alert alert-@_discoverBannerClass" role="alert">@_discoverBanner</div>
            }

            @if (_networks is null)
            {
                <p class="text-body-secondary">Loading…</p>
            }
            else if (_networks.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-broadcast" style="font-size: 4rem;" aria-hidden="true"></i>
                    <h4 class="mt-3">No WLANs discovered yet</h4>
                    <p class="text-body-secondary">Click "Discover WLANs" to scan this access point.</p>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>SSID</th>
                            <th>BSSID</th>
                            <th>Channel</th>
                            <th>Width</th>
                            <th>Tx power</th>
                            <th>Enabled</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in _networks)
                        {
                            <tr class="@(w.Enabled ? "" : "text-body-secondary")">
                                <td>@w.SSID</td>
                                <td><code class="font-monospace">@w.MacAddress</code></td>
                                <td>@w.Channel</td>
                                <td>@w.Width</td>
                                <td>@w.TxPower</td>
                                <td>
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               checked="@w.Enabled"
                                               @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => HandleEnabledToggleAsync(w, (bool)(e.Value ?? false)))" />
                                    </div>
                                    @if (_savedFlashId == w.Id)
                                    {
                                        <small class="text-success ms-2">Saved</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <ConfirmationModal IsOpen="_retrustOpen"
                       IsOpenChanged="@((bool v) => _retrustOpen = v)"
                       Title="Re-trust this access point?"
                       ConfirmLabel="Re-trust"
                       OnConfirm="HandleRetrustAsync">
        <Body>
            The fingerprint stored for "<strong>@_node.Hostname</strong>" will be cleared. The next polling
            cycle will accept whatever host key the AP advertises and trust it. Only do this if you
            intentionally re-installed this AP.
        </Body>
    </ConfirmationModal>
}

@code {
    [Parameter] public int Id { get; set; }

    private WiFiNode? _node;
    private IReadOnlyList<WiFiNetwork>? _networks;
    private bool _discovering;
    private string? _discoverBanner;
    private string _discoverBannerClass = "info";
    private bool _retrustOpen;
    private int? _savedFlashId;

    // 260517-ndr — W4 race-with-Dispose guard for the PollNotifier.Cycled subscription
    // (mirrors PollCountdown.razor:60 and Stations/Detail.razor:270 verbatim). Set to true
    // FIRST in Dispose(), BEFORE detaching the subscription, so a concurrent Cycled handler
    // invocation short-circuits before touching the (already torn-down) renderer.
    private volatile bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        // 260517-ndr — subscribe BEFORE the first LoadAsync so we cannot miss a Cycled event
        // raised in the gap between mount and first render. OnInitializedAsync runs once per
        // component lifetime; subscribe-in-Init / unsubscribe-in-Dispose paired adjacency
        // (Phase 5 D-12 / 260516-dlu pattern).
        Notifier.Cycled += OnCycleAsync;
        await LoadAsync();
    }

    // 260517-ndr — Cycled handler. The post-tx.CommitAsync raise from PollOrchestrator means a fresh
    // DB read will reflect any state flipped by the most recent cycle (notably nodes marked Offline
    // because their SSH probe failed). Re-run LoadAsync to refresh _node + _networks, then trigger
    // a re-render. Pitfall 7: the handler returns Task (NOT async void) so exceptions stay
    // observable; W4 belt-and-braces try/catch around InvokeAsync swallows the disposal race.
    private async Task OnCycleAsync(PollSnapshot s)
    {
        if (_disposed) return;     // W4: skip if dispose already happened
        await LoadAsync();
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // W4: race between Cycled raise and Dispose() -- renderer is gone, swallow.
        }
    }

    public void Dispose()
    {
        _disposed = true;     // W4: set BEFORE detaching subscription (paired adjacency invariant)
        Notifier.Cycled -= OnCycleAsync;
    }

    private async Task LoadAsync()
    {
        _node = await Nodes.GetByIdAsync(Id);
        if (_node is null)
        {
            Nav.NavigateTo("/Nodes");
            return;
        }
        _networks = await Networks.GetByNodeAsync(Id);
    }

    private async Task HandleDiscoverAsync()
    {
        _discovering = true;
        _discoverBanner = null;
        try
        {
            // D-14: within-cycle reentry → DiscoveryOutcome.Busy → alert-info inline notice.
            var outcome = await Discovery.DiscoverAsync(Id, CancellationToken.None);
            _discoverBanner = outcome.UserMessage;
            _discoverBannerClass = outcome.Severity switch
            {
                OutcomeSeverity.Success => "success",
                OutcomeSeverity.Info => "info",     // Busy maps here
                _ => "danger"
            };
            _networks = await Networks.GetByNodeAsync(Id);
        }
        finally
        {
            _discovering = false;
        }
    }

    private async Task HandleEnabledToggleAsync(WiFiNetwork w, bool enabled)
    {
        // D-16: instant write — no Save button. After write, flash a "Saved" indicator for 2s.
        await Networks.SetEnabledAsync(w.Id, enabled);
        w.Enabled = enabled;
        _savedFlashId = w.Id;
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            _savedFlashId = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task HandleRetrustAsync()
    {
        await Nodes.ClearHostKeyFingerprintAsync(Id);
        await LoadAsync();
    }

    private static string RelativeTime(DateTime t)
    {
        if (t == default) return "Never";
        var d = DateTime.UtcNow - t.ToUniversalTime();
        if (d.TotalSeconds < 60) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
}
