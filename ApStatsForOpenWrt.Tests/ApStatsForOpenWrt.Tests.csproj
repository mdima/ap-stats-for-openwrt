<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ApStatsForOpenWrt.Tests</RootNamespace>
    <!-- DEVIATION (Rule 3, blocking) the .NET 10 SDK default dotnet test mode is VSTest, which
         is incompatible with xunit.v3 + Microsoft.Testing.Platform v2 (the configuration this
         plan locks). The repo-root global.json opts the SDK into MTP-aware dotnet test mode
         (per https://aka.ms/dotnet-test-mtp-error). UseMicrosoftTestingPlatformRunner=true
         marks this project as an MTP application. CI-02 honored (forbidden cov-rlet packages absent). -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Wave 0 ships with zero tests by design (test files land in subsequent waves). MTP
         exit code 8 means "zero tests ran" and is a non-success status by default. The plan's
         acceptance criterion accepts a zero-tests run, so we tell MTP to map exit 8 to 0.
         Once tests land (Wave 1+), this remains harmless because every wave will run a
         non-empty test set. -->
    <TestingPlatformCommandLineArguments>--ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 3.2.2 (verbatim plan pin from RESEARCH.md lines 200-221) is included for
         tooling discoverability and the CsprojReferencesTests grep (CI-02). Its transitive
         xunit.v3.mtp-v1 conflicts with the v2 MTP runtime required by
         Microsoft.Testing.Extensions.CodeCoverage 18.6.2; ExcludeAssets suppresses that. -->
    <PackageReference Include="xunit.v3" Version="3.2.2">
      <ExcludeAssets>compile;runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="bunit" Version="2.7.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
    <!-- Explicit pin used by SqliteInMemoryFixture to manage the in-memory connection lifecycle.
         EF Core 10.0.7 brings it transitively, but pinning here is honest and survives any
         future EF dependency changes. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- Phase 3: WebApplicationFactory<Program> integration host. First use is Plan 03-01's
         AdminLteAssetSmokeTests; reused by Plan 03-03 AuthGate/RateLimit, Plan 03-04 Nodes
         page tests, Plan 03-05 Settings round-trip. Microsoft Learn confirms 10.0.x is the
         matching framework version for net10.0. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <!-- DEVIATION (Rule 3, blocking) the plan pin xunit.v3 3.2.2 transitively references
         xunit.v3.mtp-v1, which targets Microsoft.Testing.Platform v1.x. The locked
         Microsoft.Testing.Extensions.CodeCoverage 18.6.2 requires MTP v2.1.0 (TypeLoadException
         on IDataConsumer otherwise). Adding xunit.v3.mtp-v2 3.2.2 (same release, v2-aligned
         variant) pulls xunit.v3.core.mtp-v2 and the matching MTP v2 runtime. -->
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- Phase 6 Plan 06-03 W7 / B2 — TestCorrelator sink lets HealthSerilogFilterTests assert
         at runtime that the production .Filter.ByExcluding clause for /health is honored. The
         doubled-quote literal `p.ToString() == "\"/health\""` in Program.cs is fragile; static
         grep gates can only catch surface-level regression. CI-02 permits this package
         (only coverlet.* prefixes are blocked). -->
    <PackageReference Include="Serilog.Sinks.TestCorrelator" Version="4.0.0" />
    <!-- M-SEC-04 plan 15-04 — FakeTimeProvider lets SlidingExpirationTests drive the
         cookie auth pipeline's clock without `Thread.Sleep(6 days)`. Matches the existing
         TimeProvider seam used by PollOrchestrator. Version 9.0.x targets .NET 10 cleanly
         (10.0.x track ships separately under Microsoft.Extensions.TimeProvider.Testing
         when the .NET 10 release wave catches up; 9.0.x is the current latest GA). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.6.0" />
    <!-- Phase 7 / Testcontainers for the Docker-smoke fixture (D-06). Targets net10.0 cleanly.
         NO Testcontainers.Xunit (still v2-only as of 4.11.0); use the manual IAsyncLifetime
         pattern with [Collection(DisableParallelization = true)]. Smoke facts are gated by
         [Trait("Category","Smoke")] AND [Trait("RequiresDocker","true")] so the default
         `dotnet test ... filter-not-trait Category=Smoke` invocation excludes them on dev
         boxes and from the 80/80 coverage gate; CI's smoke-tests job runs them on
         ubuntu-latest with `filter-trait Category=Smoke`. -->
    <PackageReference Include="Testcontainers" Version="4.12.0" />
    <!-- Phase 21 Plan 21-04 / M-HRD-04 D-05 — Microsoft.Playwright drives headless Chromium for
         the CSP browser smoke gate (CspBrowserSmokeTests) ONLY. RESEARCH-pinned 1.60.0 (published
         2026-05-21, netstandard2.0, computed-compatible up through net10.0); package legitimacy was
         human-verified on nuget.org (Microsoft first-party, no advisory) via the blocking
         checkpoint:human-verify gate before install. The NuGet package ships only the managed
         driver — the Chromium binary is provisioned separately by the `playwright.ps1 install`
         chromium step (with deps) in the CI smoke-tests job + the local user_setup step; the
         browser cache lands under bin/ (gitignored), never committed. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApStatsForOpenWrt\ApStatsForOpenWrt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plan 02-02: ship golden-fixture files (and SOURCE.md / .example placeholders) alongside
         the test binary so OpenWrtOutputParserTests + FakeSshSession can read them at runtime
         from the test bin/Release/net10.0/Fixtures/... path. Plan 02-04 will populate the
         currently-skeleton fixture folders with real captured output. -->
    <None Update="Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 17 Plan 17-02: recorded GitHub /releases/latest fixture bodies consumed by
         UpdateCheckerTests via a stubbed HttpMessageHandler. These live alongside the test
         (UpdateCheck/Fixtures/...), outside the top-level Fixtures\ glob above, so they need an
         explicit copy-to-output entry. -->
    <None Update="UpdateCheck\Fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 22 Plan 22-03 / M-FLD-01: the DropbearCompat arm reads NO runtime asset from the new
         ApStatsForOpenWrt.Tests/Dropbear/ folder — the round-trip sentinel is authored INLINE in the
         two test/dropbear/*/Dockerfile images and the fixture builds those images from the
         solution-root build context. The folder holds only .cs (Compile) files, so the MTP
         "new fixture folder needs a None Update glob" rule does not apply here (no data files to
         copy to output). A glob matching *.* would redundantly touch the .cs Compile items; omitted
         deliberately. See 22-03-SUMMARY.md "glob not needed" note. -->
  </ItemGroup>
</Project>
